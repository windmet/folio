{
  "name": "megazine-blog",
  "type": "module",
  "version": "0.0.1",
  "description": "冷门同好熟肉存档站 — 日式文库本极简美学",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "validate:sources": "node scripts/validate-source-set.mjs",
    "validate:projects": "node scripts/validate-projects.mjs",
    "validate:publication": "node scripts/validate-publication.mjs",
    "audit:payload": "node scripts/audit-payload.mjs",
    "verify:project:presentation": "node scripts/verify-project-presentation.mjs",
    "verify:komatsu36:reader-copy": "node scripts/validate-reader-copy.mjs",
    "verify:komatsu36:publication": "node scripts/verify-komatsu36-publication.mjs",
    "verify:komatsu36:semantic": "node scripts/verify-komatsu36-semantic-closeout.mjs",
    "verify:komachoe:publication": "node scripts/verify-komachoe-publication.mjs",
    "verify:komachoe:browser": "node scripts/verify-komachoe-browser.mjs",
    "verify:youtube:n1": "node scripts/verify-youtube-n1-browser.mjs",
    "verify:overlay-scroll": "node scripts/verify-overlay-scroll-browser.mjs",
    "verify:rc12:y1": "node scripts/verify-rc12-y1-browser.mjs",
    "verify:rc12:mt1": "node scripts/verify-rc12-mt1-browser.mjs",
    "verify:rc12:pa1": "node scripts/verify-rc12-pa1-browser.mjs",
    "editorial:reader-copy": "node scripts/generate-reader-copy-queue.mjs",
    "editorial:export-copy": "node scripts/export-reader-copy.mjs",
    "editorial:apply-copy": "node scripts/apply-reader-copy.mjs",
    "validate:regressions": "npm run verify:komatsu36:reader-copy && npm run verify:komatsu36:publication && npm run verify:komachoe:publication",
    "validate": "npm run verify:project:presentation && npm run validate:projects && npm run build && npm run validate:publication && npm run validate:regressions",
    "preview": "astro preview",
    "tina:dev": "tinacms dev -c \"npx astro dev --host 0.0.0.0\" --noTelemetry",
    "tina:host": "tinacms build --local --skip-cloud-checks && npx astro dev --host 0.0.0.0",
    "tina:build": "tinacms build --local --skip-cloud-checks",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.2.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^22.20.1",
    "tinacms": "^3.11.0"
  }
}
