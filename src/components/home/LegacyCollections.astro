---
export interface Props {
  articleCollections: Map<string, any[]>;
}

const { articleCollections } = Astro.props;
const folders = [
  { id: 'interview', section: 'interview', title: '杂志采访' },
  { id: 'archive', section: 'archaeology', title: '文章考古' },
  { id: 'radio', section: 'radio', title: '广播旧文' },
  { id: 'note', section: 'note', title: '随笔杂谈' },
];
---

<section class="home-section home-legacy" id="legacy" aria-labelledby="home-legacy-title">
  <div class="home-section-heading">
    <div>
      <span class="home-kicker">LEGACY COLLECTIONS</span>
      <h2 id="home-legacy-title">旧文章与考古</h2>
    </div>
    <span class="home-section-code">LEGACY POSTS</span>
  </div>
  <div class="legacy-grid">
    {folders.map((folder) => {
      const articles = articleCollections.get(folder.section) || [];
      return (
        <a class="legacy-card" href={`#legacy-${folder.id}`} data-category={folder.id}>{folder.title}<span>{articles.length}</span></a>
      );
    })}
  </div>
  <div class="legacy-feed" id="legacy-feed" aria-live="polite">
    <h3 class="legacy-feed-heading" id="legacy-feed-heading">最近与推荐</h3>
    {folders.flatMap((folder) => (articleCollections.get(folder.section) || []).map((post) => ({ folder, post }))).map(({ folder, post }) => (
      <a class="legacy-article" href={`/posts/${post.id}/`} data-category={folder.id} id={`legacy-${folder.id}-${post.id}`}>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
        <span>{post.data.title}</span>
      </a>
    ))}
  </div>
</section>

<script>
  const legacyCards = document.querySelectorAll('.legacy-card');
  const legacyArticles = document.querySelectorAll('.legacy-article');
  const legacyHeading = document.getElementById('legacy-feed-heading');
  const legacyNames = { interview: '杂志采访', archive: '文章考古', radio: '广播旧文', note: '随笔杂谈' };

  function filterLegacy(category) {
    let count = 0;
    legacyArticles.forEach((article) => {
      const visible = !category || article.dataset.category === category;
      article.hidden = !visible;
      if (visible) count += 1;
    });
    legacyCards.forEach((card) => card.classList.toggle('is-active', card.dataset.category === category));
    if (legacyHeading) legacyHeading.textContent = category && legacyNames[category]
      ? `${legacyNames[category]} · ${count} 篇`
      : '最近与推荐';
  }

  function legacyCategoryFromHash() {
    const value = window.location.hash.replace('#legacy-', '');
    return legacyNames[value] ? value : '';
  }

  filterLegacy(legacyCategoryFromHash());
  window.addEventListener('hashchange', () => {
    const category = legacyCategoryFromHash();
    filterLegacy(category);
    if (category) document.getElementById('legacy-feed')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  legacyCards.forEach((card) => card.addEventListener('click', () => {
    window.location.hash = `legacy-${card.dataset.category}`;
  }));
</script>
