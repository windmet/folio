---
export interface Props {
  feed: any[];
}

const { feed } = Astro.props;
---

<section class="home-section home-recent" aria-labelledby="home-recent-title">
  <div class="home-section-heading home-section-heading--compact">
    <div>
      <span class="home-kicker">RECENT PUBLICATION</span>
      <h2 id="home-recent-title">最近更新</h2>
    </div>
    <span class="home-section-code">PROJECT + POST</span>
  </div>
  <div class="home-feed">
    {feed.slice(0, 8).map((item) => (
      <a class="home-feed-item" href={item.href} data-feed-kind={item.kind}>
        <time datetime={item.date}>{item.date}</time>
        <span class="home-feed-type">{item.kind === 'project' ? item.publicationKind?.toUpperCase() : 'POST'}</span>
        <span class="home-feed-title">{item.title}</span>
      </a>
    ))}
  </div>
</section>
