---
export interface Props {
  author: string;
  handle: string;
  time?: string;
}

const { author, handle, time } = Astro.props;
---

<div class="tweet-item reply-tweet">
  <div class="tweet-header">
    <span class="t-author">{author}</span>
    <span class="t-handle">@{handle}</span>
    {time && <span class="t-time">· {time}</span>}
  </div>
  <div class="tweet-content">
    <slot />
  </div>
</div>

<style>
  .tweet-item {
    margin: 0;
    padding: 12px 0 12px 24px;
    border-left: 3px solid #e7e5e4;
    margin-left: 12px;
    break-inside: avoid;
  }

  .tweet-header {
    margin-bottom: 8px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .t-author {
    font-weight: 700;
    font-size: 14px;
    color: #444;
  }

  .t-handle {
    font-size: 12px;
    color: #a8a29e;
  }

  .t-time {
    font-size: 12px;
    color: #c7c2bc;
  }

  .tweet-content {
    font-size: 14px;
    line-height: 1.9;
    color: #333;
  }

  .tweet-content :global(p) {
    margin: 0 0 6px 0;
    font-size: inherit;
  }
</style>
