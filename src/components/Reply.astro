---
export interface Props {
  author: string;
  handle: string;
  time?: string;
}

const { author, handle, time } = Astro.props;
---

<div class="tweet-item reply-tweet">
  <div class="tweet-header">
    <span class="t-author">{author}</span>
    <span class="t-handle">@{handle}</span>
    {time && <span class="t-time">· {time}</span>}
  </div>
  <div class="tweet-content">
    <slot />
  </div>
</div>

<style>
  .tweet-item {
    max-width: 600px;
    margin: 0 auto 6px;
    padding: 20px 24px 20px 32px;
    border-radius: 0 12px 12px 0;
    background: #f9f8f6;
    border-left: 4px solid #d6d3d1;
    break-inside: avoid;
    position: relative;
  }

  /* 节点小圆点 */
  .tweet-item::before {
    content: '';
    position: absolute;
    left: -9px;
    top: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #c7c2bc;
    border: 3px solid #fafaf9;
    z-index: 1;
  }

  .tweet-header {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .t-author {
    font-weight: 800;
    font-size: 15px;
    color: #0f1419;
  }

  .t-handle {
    font-size: 13px;
    color: #536471;
  }

  .t-time {
    font-size: 13px;
    color: #536471;
  }

  .tweet-content {
    font-size: 14px;
    line-height: 1.5;
    color: #0f1419;
    font-weight: 500;
  }

  .tweet-content :global(p) {
    margin: 0 0 6px 0;
    font-size: inherit;
  }

  .tweet-content :global(.tw-zh) {
    font-size: 15px;
    line-height: 1.6;
    color: #0f1419;
    font-weight: 600;
    margin-bottom: 4px;
    display: block;
  }

  .tweet-content :global(.tw-ja) {
    font-size: 13px;
    line-height: 1.5;
    color: #536471;
    font-weight: 400;
    margin-bottom: 12px;
    display: block;
  }

  .tweet-content :global(:last-child) {
    margin-bottom: 0 !important;
  }

  .tweet-content :global(img) {
    display: block;
    margin-top: 16px;
    width: 100%;
    height: 340px !important;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 16px;
    border: 1px solid #e1e8ed;
    cursor: zoom-in;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tweet-content :global(img.is-expanded) {
    height: auto !important;
    max-height: 1200px !important;
    object-fit: contain !important;
    background: #f7f9fa;
    cursor: zoom-out;
  }
</style>
