---
export interface Props {
  cn: string;
  jp: string;
}

const { cn, jp } = Astro.props;
const id = `bp-${crypto.randomUUID()}`;
---

<div class="bilingual-paragraph group relative my-6">
  <p class="text-base leading-loose text-stone-800 m-0">
    {cn}
    <button
      class="inline-flex items-center justify-center w-5 h-5 ml-1 align-middle
        text-[10px] text-stone-300 border border-stone-200 rounded-sm
        opacity-0 group-hover:opacity-100 group-focus-within:opacity-100
        transition-opacity duration-200 cursor-pointer
        hover:text-stone-500 hover:border-stone-400
        focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-stone-300"
      aria-expanded="false"
      aria-controls={id}
      data-toggle-jp
    >
      原
    </button>
  </p>
  <div
    id={id}
    class="jp-text overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out"
    data-jp-content
  >
    <p class="m-0 pt-2 text-sm text-stone-400 leading-loose font-mincho">
      {jp}
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-toggle-jp]').forEach((btn) => {
    const content = document.getElementById(btn.getAttribute('aria-controls')!);
    if (!content) return;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
        content.style.opacity = '0';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
      }
    });
  });
</script>
