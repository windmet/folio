---
export interface Props {
  author: string;
  handle: string;
  time?: string;
}

const { author, handle, time } = Astro.props;
---

<div class="quote-tweet">
  <div class="qt-header">
    <svg class="qt-icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="#536471">
      <g><path d="M4.5 3.88l4.432 4.43-1.414 1.414L4.5 6.71v10.5c0 1.24 1.01 2.25 2.25 2.25h10.5v2H6.75C4.13 21.46 2 19.33 2 16.71V6.71L.982 7.724.432 6.31 4.5 3.88zM17.25 2.54c2.62 0 4.75 2.13 4.75 4.75v10l1.018-1.014 1.414 1.414-4.068 4.43-4.432-4.43 1.414-1.414 3.018 3.01V7.29c0-1.24-1.01-2.25-2.25-2.25H6.75v-2h10.5z"></path></g>
    </svg>
    <span class="t-author">{author}</span>
    <span class="t-handle">@{handle}</span>
    {time && <span class="t-time">· {time}</span>}
  </div>
  <div class="qt-content">
    <slot />
  </div>
</div>

<style>
  .quote-tweet {
    border: 2px solid #e1e8ed;
    border-radius: 16px;
    padding: 20px;
    margin: 16px 0;
    background-color: #ffffff;
  }

  .qt-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .qt-icon {
    width: 18px;
    height: 18px;
    fill: #536471;
    flex-shrink: 0;
    margin-right: 2px;
  }

  .qt-content {
    font-size: 13px;
    line-height: 1.5;
    color: #0f1419;
    font-weight: 500;
  }

  .qt-content :global(p) {
    margin: 0 0 6px 0;
    font-size: inherit;
  }

  /* 双语排版 */
  .qt-content :global(.tw-zh) {
    font-size: 14px;
    line-height: 1.6;
    color: #0f1419;
    font-weight: 600;
    margin-bottom: 3px;
    display: block;
  }

  .qt-content :global(.tw-ja) {
    font-size: 12px;
    line-height: 1.5;
    color: #536471;
    font-weight: 400;
    margin-bottom: 10px;
    display: block;
  }

  .qt-content :global(:last-child) {
    margin-bottom: 0 !important;
  }

  /* 图片：默认卡片裁剪 + 点击展开 */
  .qt-content :global(img) {
    display: block;
    margin-top: 12px;
    width: 100%;
    height: 240px !important;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 12px;
    border: 1px solid #e1e8ed;
    cursor: zoom-in;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .qt-content :global(img.is-expanded) {
    height: auto !important;
    max-height: 1200px !important;
    object-fit: contain !important;
    background: #f7f9fa;
    cursor: zoom-out;
  }
</style>

