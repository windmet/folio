---
export interface Props {
  mentions: any[];
  eventsById: Map<string, any>;
}

const { mentions, eventsById } = Astro.props;
const localId = (id: string) => id.split('/').at(-1) || id;
const referenceId = (reference: any) => reference?.id || reference;
const formatTime = (milliseconds: number) => {
  const total = Math.max(0, Math.floor(milliseconds / 1000));
  return [Math.floor(total / 3600), Math.floor((total % 3600) / 60), total % 60]
    .map((part) => String(part).padStart(2, '0')).join(':');
};
const groups = [
  { kind: 'work', en: 'WORKS', label: '作品 / 企划' },
  { kind: 'person', en: 'PEOPLE', label: '人物' },
  { kind: 'context', en: 'CONTEXT', label: '背景 / 词条' },
];
const eventsFor = (mention: any) => (mention.events || [])
  .map((reference: any) => eventsById.get(referenceId(reference)))
  .filter(Boolean)
  .sort((left: any, right: any) => left.data.startMs - right.data.startMs);
---

<section class="project-view mentions-view" data-view-panel="mentions" hidden>
  <div class="view-heading">
    <span class="archive-kicker">MENTION INDEX</span>
    <h2>Mentions</h2>
    <p>本期提及的人物、作品与背景信息。点击时间直接回到 Timeline；外部链接只用于补充公开资料。</p>
  </div>

  <div class="mentions-groups">
    {groups.map((group) => {
      const groupMentions = mentions.filter((mention: any) => mention.kind === group.kind);
      if (groupMentions.length === 0) return null;
      return (
        <section class="mentions-group" data-mention-kind={group.kind}>
          <header class="mentions-group__heading">
            <div>
              <span class="archive-kicker">{group.en}</span>
              <h3>{group.label}</h3>
            </div>
            <small>{String(groupMentions.length).padStart(2, '0')}</small>
          </header>
          <div class="mentions-list">
            {groupMentions.map((mention: any) => {
              const events = eventsFor(mention);
              return (
                <article class="mention-row" data-mention-row={mention.id} id={`mention-${mention.id}`}>
                  <div class="mention-row__copy">
                    <h4>{mention.label}</h4>
                    <p>{mention.summary}</p>
                  </div>
                  <div class="mention-row__actions">
                    <div class="mention-times" aria-label={`${mention.label} 在 Timeline 的提及时间`}>
                      {events.map((event: any) => (
                        <button
                          type="button"
                          class="mention-time"
                          data-mention-event={localId(event.id)}
                          aria-label={`在 Timeline 查看 ${mention.label}：${formatTime(event.data.startMs)}`}
                        >
                          {formatTime(event.data.startMs)} <span aria-hidden="true">→</span>
                        </button>
                      ))}
                    </div>
                    {mention.url && (
                      <a class="mention-source" href={mention.url} target="_blank" rel="noopener noreferrer">
                        {mention.kind === 'context' ? '背景资料' : '官方资料'} ↗
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</section>
