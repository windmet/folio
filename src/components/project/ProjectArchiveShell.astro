---
import { render } from 'astro:content';
import ArchivePlayer from './ArchivePlayer.astro';
import ActSection from './ActSection.astro';
import ThreadPanel from './ThreadPanel.astro';
import PersonPopover from './PersonPopover.astro';
import ProjectSearch from './ProjectSearch.astro';
import MediaSourceNavigator from './MediaSourceNavigator.astro';
import CastMatrix from './CastMatrix.astro';
import PersonCard from './PersonCard.astro';
import LeadPersonCard from './LeadPersonCard.astro';

export interface Props {
  project: any;
  tracks: any[];
  acts: any[];
  events: any[];
  threads: any[];
  people: any[];
  sources: any[];
}

const { project, tracks, acts, events, threads, people, sources } = Astro.props;
const localId = (id: string) => id.split('/').at(-1) || id;
const referenceId = (reference: any) => reference.id;
const peopleById = new Map(people.map((person) => [person.id, person]));
const eventsById = new Map(events.map((event) => [event.id, event]));
const tracksById = new Map(tracks.map((track) => [track.id, track]));
const sourcesById = new Map(sources.map((source) => [source.id, source]));
const threadsByEvent = new Map<string, string[]>();
const threadsByPerson = new Map<string, string[]>();
const eventsByPerson = new Map<string, any[]>();

for (const thread of threads) {
  for (const node of thread.data.nodes) {
    const list = threadsByEvent.get(referenceId(node.event)) || [];
    list.push(localId(thread.id));
    threadsByEvent.set(referenceId(node.event), list);
  }
}

for (const threadIds of threadsByEvent.values()) {
  threadIds.sort((a, b) => a.localeCompare(b, 'en'));
}

for (const event of events) {
  for (const personReference of event.data.people) {
    const list = eventsByPerson.get(referenceId(personReference)) || [];
    list.push(event);
    eventsByPerson.set(referenceId(personReference), list);
  }
}

for (const thread of threads) {
  const personIds = new Set<string>();
  for (const node of thread.data.nodes) {
    const event = eventsById.get(referenceId(node.event));
    for (const personReference of event?.data.people || []) personIds.add(referenceId(personReference));
  }
  for (const personId of personIds) {
    const list = threadsByPerson.get(personId) || [];
    list.push(localId(thread.id));
    threadsByPerson.set(personId, list);
  }
}

for (const threadIds of threadsByPerson.values()) {
  threadIds.sort((left, right) => {
    const leftThread = threads.find((thread) => localId(thread.id) === left);
    const rightThread = threads.find((thread) => localId(thread.id) === right);
    return Number(rightThread?.data.featured) - Number(leftThread?.data.featured)
      || leftThread?.data.title.localeCompare(rightThread?.data.title, 'zh-CN');
  });
}

const threadViews = await Promise.all(threads.map(async (entry) => {
  const { Content } = await render(entry);
  return {
    entry,
    Content,
    relatedSources: (entry.data.relatedSources || []).map((relatedSource: any) => ({
      source: sourcesById.get(referenceId(relatedSource.source)),
      afterEvent: referenceId(relatedSource.afterEvent),
      context: relatedSource.context,
    })).filter((relatedSource: any) => relatedSource.source),
    nodes: entry.data.nodes.map((node: any) => ({
      event: eventsById.get(referenceId(node.event)),
      role: node.role,
      transition: node.transition,
      trackLabel: tracksById.get(referenceId(eventsById.get(referenceId(node.event))?.data.track))?.data.shortLabel || '—',
    })).filter((node: any) => node.event),
  };
}));

const defaultTrack = tracks.find((track) => track.id === referenceId(project.data.defaultTrack)) || tracks[0];
const orderedActs = [...acts].sort((a, b) => a.data.order - b.data.order);
const orderedThreads = [...threads].sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'zh-CN'));
const orderedPeople = [...people].sort((a, b) => a.data.displayName.localeCompare(b.data.displayName, 'zh-CN'));
const leadPersonId = 'komatsu-shohei';
const leadPerson = orderedPeople.find((person) => localId(person.id) === leadPersonId);
const publishedEvents = events.filter((event) => event.data.publicationStatus !== 'withheld');
const orderedSearchEvents = [...publishedEvents].sort((a, b) =>
  referenceId(a.data.track).localeCompare(referenceId(b.data.track), 'en')
  || a.data.startMs - b.data.startMs
  || localId(a.id).localeCompare(localId(b.id), 'en'));
const eventsForAct = (actId: string) => publishedEvents
  .filter((event) => event.data.act?.id === actId)
  .sort((a, b) => a.data.startMs - b.data.startMs);
const payoffEvent = publishedEvents.find((event) => localId(event.id) === 'yt-030923-takoyaki-payoff');

const controllerData = {
  projectId: project.id,
  defaultView: project.data.defaultView,
  defaultTrackId: localId(defaultTrack.id),
  tracks: Object.fromEntries(tracks.map((track) => [localId(track.id), {
    id: localId(track.id),
    label: track.data.label,
    shortLabel: track.data.shortLabel,
    kind: track.data.kind,
    durationMs: track.data.durationMs,
    playback: track.data.playback,
    fallbackUrl: track.data.fallbackUrl,
  }])),
  events: Object.fromEntries(publishedEvents.map((event) => [localId(event.id), {
    id: localId(event.id),
    trackId: localId(referenceId(event.data.track)),
    startMs: event.data.startMs,
    title: event.data.title,
    threadIds: localId(referenceId(event.data.track)) === localId(defaultTrack.id) ? [] : (threadsByEvent.get(event.id) || []),
  }])),
};
const serializedControllerData = JSON.stringify(controllerData).replaceAll('<', '\\u003c');
---

<project-archive-shell data-project-archive>
  <header class="project-hero">
    <div class="project-hero__copy">
      <span class="archive-kicker">{project.data.eyebrow}</span>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      <div class="project-facts" aria-label="项目摘要">
        <span>04:57:26</span>
        <span>360° YouTube</span>
        <span>YT + 2 Spaces</span>
        <span>16 Story Threads</span>
      </div>
    </div>
    <div class="project-hero__stamp" aria-hidden="true">
      <strong>{project.data.mark || 'A'}</strong>
      <span>BIRTHDAY<br />SPECIAL</span>
    </div>
  </header>

  <MediaSourceNavigator tracks={tracks} events={publishedEvents} sources={sources} />

  <nav class="project-nav" aria-label="专题视图">
    {[
      ['overview', 'Overview', '快速了解'],
      ['timeline', 'Timeline', '按时间浏览'],
      ['storylines', 'Storylines', '精彩事件'],
      ['people', 'People', '人物'],
      ['transcript', 'Transcript', '完整资料'],
    ].map(([id, en, zh]) => (
      <button type="button" data-view-button={id} aria-pressed="false">
        <strong>{en}</strong><span>{zh}</span>
      </button>
    ))}
  </nav>

  <ProjectSearch
    events={orderedSearchEvents}
    threads={orderedThreads}
    people={orderedPeople}
    tracks={tracks}
    threadsByEvent={threadsByEvent}
  />

  <div class="project-workspace">
    <div class="project-content">
      <section class="project-view overview-view" data-view-panel="overview" hidden>
        <div class="view-heading">
          <span class="archive-kicker">FIVE-MINUTE ORIENTATION</span>
          <h2>一条线看懂这场活动</h2>
          <p>这不是五小时流水账。当前垂直切片先展示“提议 → 识破 → 干扰 → 遗忘 → 80 分钟后回收”怎样被转换成可进入、可跳转的档案。</p>
        </div>
        <div class="overview-grid">
          <article>
            <span>01</span><h3>生日会</h3><p>礼物、赛马、俳句、Bingo 与最后的 36 岁抱负。</p>
          </article>
          <article>
            <span>02</span><h3>《俺知》打ち上げ</h3><p>名场面、动作、方言与朗读形式的现场复盘。</p>
          </article>
          <article>
            <span>03</span><h3>Space 技术线</h3><p>主播反复离席，另一平台的事件又回流到主桌。</p>
          </article>
        </div>
        {payoffEvent && (
          <button type="button" class="featured-jump" data-event-seek={localId(payoffEvent.id)}>
            <span class="archive-kicker">FEATURED PAYOFF · 03:09:23</span>
            <strong>{payoffEvent.data.title}</strong>
            <span>定位并进入时间线 →</span>
          </button>
        )}
      </section>

      <section class="project-view timeline-view" data-view-panel="timeline" hidden>
        <div class="view-heading">
          <span class="archive-kicker">CHRONOLOGICAL CANON · YT NATIVE CLOCK</span>
          <h2>Timeline</h2>
          <p>八个 Act 按 YouTube 主直播时间排列；Space 的相关段落请从 Storylines 查看，不把两个现场的时钟硬拼在一起。</p>
        </div>
        {orderedActs.map((act) => (
          <ActSection act={act} events={eventsForAct(act.id)} peopleById={peopleById} threadsByEvent={threadsByEvent} />
        ))}
      </section>

      <section class="project-view storylines-view" data-view-panel="storylines" hidden>
        <div class="view-heading">
          <span class="archive-kicker">CONTEXT RECONSTRUCTION</span>
          <h2>Storylines</h2>
          <p>事件线按故事发展顺序排列；跨平台段落保留各自时间，不强行合并成一个时钟。</p>
        </div>
        <div class="storyline-list">
          {orderedThreads.map((thread) => (
            <button type="button" class="storyline-card" data-open-thread={localId(thread.id)}>
              <span>{thread.data.category.replaceAll('-', ' ').toUpperCase()}</span>
              <h3>{thread.data.title}</h3>
              <p>{thread.data.deck}</p>
              <strong>{thread.data.nodes.length} 个节点 · 查看完整事件线 →</strong>
            </button>
          ))}
        </div>
      </section>

      <section class="project-view people-view" data-view-panel="people" hidden>
        <div class="view-heading">
          <span class="archive-kicker">PEOPLE / CAST</span>
          <h2>People</h2>
          <p>先看这场企划的中心人物与《俺知》昼夜 Cast，再看制作、生日会和 X Space / Remote 参与关系。人物事件仍由 Event → Person 引用反向生成。</p>
        </div>
        {leadPerson && (
          <section class="people-lead" aria-labelledby="people-lead-title">
            <div class="people-group__heading"><span>00</span><h3 id="people-lead-title">HOST / BIRTHDAY</h3></div>
            <LeadPersonCard person={leadPerson} eventCount={(eventsByPerson.get(leadPerson.id) || []).length} />
          </section>
        )}
        <section class="people-group">
          <div class="people-group__heading"><span>01</span><h3>ORE-SHIRI CAST</h3></div>
          <CastMatrix people={orderedPeople} />
        </section>
        <section class="people-group">
          <div class="people-group__heading"><span>02</span><h3>PRODUCTION / ACTION</h3></div>
          <div class="people-grid">
            {orderedPeople.filter((person) => (person.data.participation || []).some((item: any) => ['production', 'ensemble'].includes(item.kind))).map((person) => (
              <PersonCard person={person} group="production" eventCount={(eventsByPerson.get(person.id) || []).length} />
            ))}
          </div>
        </section>
        <section class="people-group">
          <div class="people-group__heading"><span>03</span><h3>BIRTHDAY LIVE PARTICIPANTS</h3></div>
          <div class="people-grid">
            {orderedPeople.filter((person) => localId(person.id) !== leadPersonId && (person.data.participation || []).some((item: any) => item.kind === 'birthday-live')).map((person) => (
              <PersonCard person={person} group="birthday-live" eventCount={(eventsByPerson.get(person.id) || []).length} />
            ))}
          </div>
        </section>
        <section class="people-group">
          <div class="people-group__heading"><span>04</span><h3>X SPACE / REMOTE</h3></div>
          <div class="people-grid">
            {orderedPeople.filter((person) => (person.data.participation || []).some((item: any) => ['space-guest', 'remote-call', 'space-account'].includes(item.kind))).map((person) => (
              <PersonCard person={person} group="space-remote" eventCount={(eventsByPerson.get(person.id) || []).length} />
            ))}
          </div>
        </section>
      </section>

      <section class="project-view transcript-view" data-view-panel="transcript" hidden>
        <div class="view-heading">
          <span class="archive-kicker">RIGHTS GATE</span>
          <h2>Transcript 暂不公开</h2>
          <p>逐字稿暂不公开；本档案先提供时间线、事件摘要和事件线，保留原始媒体入口。</p>
        </div>
      </section>
    </div>

    <aside class="project-player-column">
      <ArchivePlayer
        trackId={localId(defaultTrack.id)}
        label={defaultTrack.data.label}
        videoId={defaultTrack.data.playback.provider === 'youtube' ? defaultTrack.data.playback.videoId : undefined}
        fallbackUrl={defaultTrack.data.fallbackUrl}
        tracks={tracks}
      />
    </aside>
  </div>

  <ThreadPanel threads={threadViews} />
  <PersonPopover
    people={orderedPeople}
    eventsByPerson={eventsByPerson}
    tracksById={tracksById}
    threadsByEvent={threadsByEvent}
    threadsByPerson={threadsByPerson}
    threadsById={new Map(orderedThreads.map((thread) => [localId(thread.id), thread]))}
    defaultTrackId={defaultTrack.id}
  />
  <script type="application/json" data-archive-controller-data set:html={serializedControllerData}></script>
</project-archive-shell>

<script>
  type ArchiveEvent = {
    id: string;
    trackId: string;
    startMs: number;
    title: string;
    threadIds: string[];
  };
  type ArchiveTrack = {
    id: string;
    label: string;
    shortLabel: string;
    kind: 'video' | 'audio';
    durationMs: number;
    playback: { provider: 'youtube'; videoId: string } | { provider: 'external'; url: string } | { provider: 'unavailable' };
    fallbackUrl?: string;
  };
  type ControllerData = {
    projectId: string;
    defaultView: string;
    defaultTrackId: string;
    tracks: Record<string, ArchiveTrack>;
    events: Record<string, ArchiveEvent>;
  };
  type EventArchiveContext = {
    threadIds: string[];
    actId?: string;
    actLabel?: string;
    actTitle?: string;
  };

  declare global {
    interface Window {
      YT?: any;
      onYouTubeIframeAPIReady?: () => void;
      __folioYouTubeApi?: Promise<any>;
    }
  }

  const loadYouTubeApi = () => {
    if (window.YT?.Player) return Promise.resolve(window.YT);
    if (window.__folioYouTubeApi) return window.__folioYouTubeApi;
    window.__folioYouTubeApi = new Promise((resolve, reject) => {
      const previous = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        previous?.();
        resolve(window.YT);
      };
      const script = document.createElement('script');
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      script.addEventListener('error', () => reject(new Error('YouTube API failed to load')), { once: true });
      document.head.append(script);
    });
    return window.__folioYouTubeApi;
  };

  class ProjectArchiveShellElement extends HTMLElement {
    data!: ControllerData;
    activeView = 'timeline';
    activeTrackId = '';
    selectedEventId: string | null = null;
    selectedThreadId: string | null = null;
    selectedPersonId: string | null = null;
    player: any = null;
    playerReady = false;
    pendingSeekMs: number | null = null;
    playbackSyncTimer: number | null = null;
    returnFocus: HTMLElement | null = null;
    lockedScrollY = 0;
    lockedBodyPaddingRight = '';
    searchOpen = false;
    sourceEventsOpen = false;
    contextFocusObserver: ResizeObserver | null = null;
    contextArrivalTimer: number | null = null;

    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      this.dataset.ready = 'true';
      const dataNode = this.querySelector('[data-archive-controller-data]');
      if (!(dataNode instanceof HTMLScriptElement)) return;
      this.data = JSON.parse(dataNode.textContent || '{}');
      this.activeTrackId = this.data.defaultTrackId;
      this.bindEvents();
      this.restoreFromUrl();
    }

    disconnectedCallback() {
      this.stopPlaybackSync();
      this.contextFocusObserver?.disconnect();
      if (this.contextArrivalTimer !== null) window.clearTimeout(this.contextArrivalTimer);
    }

    bindEvents() {
      this.querySelectorAll<HTMLElement>('[data-view-button]').forEach((button) => {
        button.addEventListener('click', () => this.showView(button.dataset.viewButton || 'timeline', true));
      });
      this.querySelectorAll<HTMLElement>('[data-event-seek]').forEach((button) => {
        button.addEventListener('click', () => this.selectEvent(button.dataset.eventSeek || '', true, true));
      });
      this.querySelectorAll<HTMLElement>('[data-source-track]').forEach((button) => {
        button.addEventListener('click', () => this.switchTrack(button.dataset.sourceTrack || '', true));
      });
      this.querySelectorAll<HTMLElement>('[data-source-browse]').forEach((button) => {
        button.addEventListener('click', () => {
          const trackId = button.dataset.sourceBrowse || '';
          this.switchTrack(trackId, true);
          this.showSourceEventIndex(trackId);
        });
      });
      this.querySelectorAll<HTMLElement>('[data-source-event]').forEach((button) => {
        button.addEventListener('click', () => this.selectEvent(button.dataset.sourceEvent || '', true, true));
      });
      this.querySelectorAll<HTMLElement>('[data-thread-event-id]').forEach((button) => {
        button.addEventListener('click', () => this.selectEvent(button.dataset.threadEventId || '', true, true));
      });
      this.querySelectorAll<HTMLElement>('[data-person-event-id]').forEach((button) => {
        button.addEventListener('click', () => {
          const eventId = button.dataset.personEventId || '';
          this.navigateToEventContext(eventId, {
            origin: 'person',
            preferredThreadId: button.dataset.personThread,
          });
        });
      });
      this.querySelectorAll<HTMLElement>('[data-open-thread]').forEach((button) => {
        button.addEventListener('click', () => this.openThread(button.dataset.openThread || '', button, true));
      });
      this.querySelectorAll<HTMLElement>('[data-open-person]').forEach((button) => {
        button.addEventListener('click', () => this.openPerson(button.dataset.openPerson || '', button, true));
      });
      this.querySelectorAll<HTMLElement>('[data-close-thread]').forEach((button) => button.addEventListener('click', () => this.closeThread(true)));
      this.querySelectorAll<HTMLElement>('[data-close-person]').forEach((button) => button.addEventListener('click', () => this.closePerson(true)));
      this.querySelector<HTMLElement>('[data-load-player]')?.addEventListener('click', () => this.ensurePlayer());
      this.querySelector<HTMLElement>('[data-player-context-cta]')?.addEventListener('click', () => {
        if (!this.selectedEventId) return;
        this.navigateToEventContext(this.selectedEventId, { origin: 'player' });
      });
      this.querySelector<HTMLElement>('[data-player-context-thread-list]')?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('[data-player-context-thread]');
        if (!button || !this.selectedEventId) return;
        this.navigateToEventContext(this.selectedEventId, {
          origin: 'player',
          preferredThreadId: button.dataset.playerContextThread,
        });
      });
      this.querySelector<HTMLElement>('[data-player-rail-node]')?.addEventListener('click', () => {
        if (!this.selectedEventId) return;
        this.navigateToEventContext(this.selectedEventId, { origin: 'player' });
      });
      this.querySelector<HTMLElement>('[data-player-rail-act]')?.addEventListener('click', () => {
        if (this.selectedEventId) this.navigateToEventAct(this.selectedEventId);
      });
      this.querySelector<HTMLElement>('[data-player-rail-thread]')?.addEventListener('click', () => {
        if (!this.selectedEventId) return;
        const threadIds = this.getEventArchiveContext(this.selectedEventId).threadIds;
        if (threadIds.length === 0) return;
        if (threadIds.length === 1) {
          this.closePlayerRailThreadMenu(false);
          this.openThreadFromPlayerRail(threadIds[0]);
          return;
        }
        this.togglePlayerRailThreadMenu(threadIds);
      });
      this.querySelector<HTMLElement>('[data-player-rail-thread-list]')?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>('[data-player-rail-thread-option]');
        if (!button || !this.selectedEventId) return;
        const threadId = button.dataset.playerRailThreadOption;
        if (!threadId) return;
        this.closePlayerRailThreadMenu(false);
        this.openThreadFromPlayerRail(threadId);
      });
      document.addEventListener('click', (event) => {
        const menu = this.querySelector<HTMLElement>('[data-player-rail-thread-menu]');
        if (menu?.hidden) return;
        const slot = this.querySelector<HTMLElement>('.player-context-rail__thread-slot');
        if (slot && !slot.contains(event.target as Node)) this.closePlayerRailThreadMenu(false);
      });
      const searchInput = this.querySelector<HTMLInputElement>('[data-archive-search]');
      searchInput?.addEventListener('input', () => this.filterSearch(searchInput.value));
      this.querySelector<HTMLElement>('[data-search-clear]')?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        this.closeSearch(true);
      });
      this.querySelectorAll<HTMLElement>('[data-search-event]').forEach((button) => {
        button.addEventListener('click', () => {
          const eventId = button.dataset.searchEvent || '';
          this.navigateToEventContext(eventId, {
            origin: 'search',
            preferredThreadId: button.dataset.searchThread,
          });
        });
      });
      this.querySelectorAll<HTMLElement>('[data-search-kind="thread"]').forEach((button) => {
        button.addEventListener('click', () => {
          this.closeSearch(false);
          this.showView('storylines', false);
          this.openThread(button.dataset.searchThread || '', searchInput || null, true);
        });
      });
      this.querySelectorAll<HTMLElement>('[data-search-person]').forEach((button) => {
        button.addEventListener('click', () => {
          this.closeSearch(false);
          this.showView('people', false);
          this.openPerson(button.dataset.searchPerson || '', searchInput || null, true);
        });
      });
      window.addEventListener('popstate', () => this.restoreFromUrl());
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Tab' && (this.selectedThreadId || this.selectedPersonId)) {
          this.trapModalFocus(event);
          return;
        }
        if (event.key !== 'Escape') return;
        const railMenu = this.querySelector<HTMLElement>('[data-player-rail-thread-menu]');
        if (railMenu && !railMenu.hidden) this.closePlayerRailThreadMenu(true);
        else if (this.selectedPersonId) this.closePerson(true);
        else if (this.selectedThreadId) this.closeThread(true);
        else if (this.searchOpen) this.closeSearch(true);
      });
    }

    filterSearch(query: string) {
      const normalized = query.trim().toLocaleLowerCase('ja-JP');
      const panel = this.querySelector<HTMLElement>('[data-search-results]');
      const input = this.querySelector<HTMLInputElement>('[data-archive-search]');
      const clear = this.querySelector<HTMLElement>('[data-search-clear]');
      const empty = this.querySelector<HTMLElement>('[data-search-empty]');
      const count = this.querySelector<HTMLElement>('[data-search-count]');
      if (!panel || !input) return;
      if (!normalized) {
        this.closeSearch(false);
        return;
      }
      let matches = 0;
      this.querySelectorAll<HTMLElement>('[data-search-item]').forEach((item) => {
        const matched = (item.dataset.searchText || '').includes(normalized);
        item.hidden = !matched;
        if (matched) matches += 1;
      });
      this.searchOpen = true;
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      if (clear) clear.hidden = false;
      if (empty) empty.hidden = matches !== 0;
      if (count) count.textContent = `${matches} 条结果`;
    }

    closeSearch(focus: boolean) {
      this.searchOpen = false;
      const panel = this.querySelector<HTMLElement>('[data-search-results]');
      const input = this.querySelector<HTMLInputElement>('[data-archive-search]');
      const clear = this.querySelector<HTMLElement>('[data-search-clear]');
      if (panel) panel.hidden = true;
      if (input) input.setAttribute('aria-expanded', 'false');
      if (clear) clear.hidden = !(input?.value);
      if (focus) input?.focus({ preventScroll: true });
    }

    showView(view: string, push: boolean) {
      const panel = this.querySelector(`[data-view-panel="${CSS.escape(view)}"]`);
      if (!panel) view = this.data.defaultView;
      this.activeView = view;
      this.querySelectorAll<HTMLElement>('[data-view-panel]').forEach((item) => { item.hidden = item.dataset.viewPanel !== view; });
      this.querySelectorAll<HTMLElement>('[data-view-button]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
      });
      this.updatePlayerRailActiveState();
      if (push) this.updateUrl();
    }

    navigateToEventContext(eventId: string, options: { origin: 'person' | 'search' | 'player'; preferredThreadId?: string }) {
      const event = this.data.events[eventId];
      if (!event) return;

      const contextTrigger = options.origin === 'player' && document.activeElement instanceof HTMLElement
        ? document.activeElement
        : options.origin === 'player'
          ? this.querySelector<HTMLElement>('[data-player-context-cta]')
          : null;
      this.closeSearch(false);
      if (this.selectedThreadId) this.closeThread(false);
      if (this.selectedPersonId) this.closePerson(false);

      this.selectEvent(eventId, false, options.origin !== 'player');
      const threadIds = this.getEventArchiveContext(eventId).threadIds;
      const preferredThreadId = options.preferredThreadId && threadIds.includes(options.preferredThreadId)
        ? options.preferredThreadId
        : undefined;
      const orderedThreadIds = preferredThreadId
        ? [preferredThreadId, ...threadIds.filter((threadId) => threadId !== preferredThreadId)]
        : threadIds;

      if (event.trackId === this.data.defaultTrackId) {
        this.showView('timeline', false);
        this.writeUrl('push');
        this.scheduleTimelineContextFocus(eventId);
        return;
      }

      if (orderedThreadIds.length === 0) {
        this.showSourceEventIndex(event.trackId);
        this.writeUrl('push');
        window.requestAnimationFrame(() => this.focusSourceEvent(eventId));
        return;
      }

      this.showView('storylines', false);
      if (orderedThreadIds.length === 1 || preferredThreadId) {
        this.openThread(preferredThreadId || orderedThreadIds[0], contextTrigger, false);
      } else if (options.origin === 'player' && this.isPlayerRailAvailable()) {
        this.openPlayerRailThreadMenu(orderedThreadIds);
      } else {
        this.renderPlayerContextThreads(eventId, orderedThreadIds);
        const choices = this.querySelector<HTMLElement>('[data-player-context-threads]');
        if (choices) choices.hidden = false;
      }
      this.writeUrl('push');
      if (threadIds.length > 1 && !(options.origin === 'player' && this.isPlayerRailAvailable())) {
        window.requestAnimationFrame(() => {
          this.querySelector<HTMLElement>('[data-player-context-thread]')?.focus({ preventScroll: true });
        });
      }
    }

    scheduleTimelineContextFocus(eventId: string) {
      this.contextFocusObserver?.disconnect();
      this.contextFocusObserver = null;
      const target = this.querySelector<HTMLElement>(`[data-timeline-event="${CSS.escape(eventId)}"]`);
      const playerColumn = this.querySelector<HTMLElement>('.project-player-column');
      if (target && playerColumn && typeof ResizeObserver !== 'undefined') {
        this.contextFocusObserver = new ResizeObserver(() => {
          this.focusTimelineEvent(eventId);
        });
        this.contextFocusObserver.observe(playerColumn);
        let observationFrames = 0;
        const releaseObservation = () => {
          if (!this.contextFocusObserver) return;
          observationFrames += 1;
          if (observationFrames >= 180) {
            this.contextFocusObserver.disconnect();
            this.contextFocusObserver = null;
            return;
          }
          window.requestAnimationFrame(releaseObservation);
        };
        window.requestAnimationFrame(releaseObservation);
      }
      this.focusTimelineEvent(eventId);
    }

    focusTimelineEvent(eventId: string) {
      const target = this.querySelector<HTMLElement>(`[data-timeline-event="${CSS.escape(eventId)}"]`);
      if (!target) return false;
      const nav = this.querySelector<HTMLElement>('.project-nav');
      const mobilePlayer = window.matchMedia('(max-width: 600px)').matches
        ? this.querySelector<HTMLElement>('.project-player-column')
        : null;
      const offset = (nav?.getBoundingClientRect().height || 0)
        + (mobilePlayer?.getBoundingClientRect().height || 0)
        + 16;
      target.style.scrollMarginTop = `${Math.ceil(offset)}px`;
      target.scrollIntoView({ behavior: 'auto', block: 'start' });
      target.focus({ preventScroll: true });
      this.markTimelineArrival(target);
      const rect = target.getBoundingClientRect();
      return rect.top < window.innerHeight && rect.bottom > offset;
    }

    markTimelineArrival(target: HTMLElement) {
      this.querySelectorAll<HTMLElement>('.timeline-event.is-context-arrival').forEach((item) => item.classList.remove('is-context-arrival'));
      if (this.contextArrivalTimer !== null) window.clearTimeout(this.contextArrivalTimer);
      target.classList.add('is-context-arrival');
      this.contextArrivalTimer = window.setTimeout(() => {
        target.classList.remove('is-context-arrival');
        this.contextArrivalTimer = null;
      }, 1400);
    }

    focusSourceEvent(eventId: string) {
      this.querySelector<HTMLElement>(`[data-source-event="${CSS.escape(eventId)}"]`)?.focus({ preventScroll: true });
    }

    renderPlayerContextThreads(eventId: string, threadIds: string[]) {
      const list = this.querySelector<HTMLElement>('[data-player-context-thread-list]');
      if (!list) return;
      list.replaceChildren();
      for (const threadId of threadIds) {
        const detail = this.querySelector<HTMLElement>(`[data-thread-detail="${CSS.escape(threadId)}"]`);
        const title = detail?.querySelector('h2')?.textContent?.trim() || threadId;
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.playerContextThread = threadId;
        button.textContent = title;
        list.append(button);
      }
      list.dataset.playerContextEvent = eventId;
    }

    getEventArchiveContext(eventId: string): EventArchiveContext {
      const event = this.data.events[eventId];
      if (!event) return { threadIds: [] };
      const timelineTarget = this.querySelector<HTMLElement>(`[data-timeline-event="${CSS.escape(eventId)}"]`);
      const actSection = timelineTarget?.closest<HTMLElement>('[data-act]');
      const domThreadIds = timelineTarget
        ? [...timelineTarget.querySelectorAll<HTMLElement>('[data-open-thread]')]
          .map((button) => button.dataset.openThread || '')
          .filter(Boolean)
        : [];
      const threadIds = [...new Set([...(event.threadIds || []), ...domThreadIds])];
      if (!actSection) return { threadIds };
      return {
        threadIds,
        actId: actSection.dataset.act,
        actLabel: actSection.querySelector<HTMLElement>('.act-number strong')?.textContent?.trim(),
        actTitle: actSection.querySelector<HTMLElement>('.act-header h2')?.textContent?.trim(),
      };
    }

    navigateToEventAct(eventId: string) {
      const event = this.data.events[eventId];
      const context = this.getEventArchiveContext(eventId);
      if (!event || event.trackId !== this.data.defaultTrackId || !context.actId) return;
      const stateChanged = this.activeView !== 'timeline' || this.selectedEventId !== eventId
        || Boolean(this.selectedThreadId || this.selectedPersonId || this.searchOpen);
      this.closeSearch(false);
      if (this.selectedThreadId) this.closeThread(false);
      if (this.selectedPersonId) this.closePerson(false);
      this.closePlayerRailThreadMenu(false);
      this.selectEvent(eventId, false, false);
      this.showView('timeline', false);
      if (stateChanged) this.writeUrl('push');
      window.requestAnimationFrame(() => this.focusEventAct(eventId));
    }

    focusEventAct(eventId: string) {
      const timelineTarget = this.querySelector<HTMLElement>(`[data-timeline-event="${CSS.escape(eventId)}"]`);
      const header = timelineTarget?.closest<HTMLElement>('[data-act]')?.querySelector<HTMLElement>('[data-act-header]');
      if (!header) return;
      const nav = this.querySelector<HTMLElement>('.project-nav');
      const offset = (nav?.getBoundingClientRect().height || 0) + 16;
      header.style.scrollMarginTop = `${Math.ceil(offset)}px`;
      header.scrollIntoView({ behavior: 'auto', block: 'start' });
      header.focus({ preventScroll: true });
    }

    isPlayerRailAvailable() {
      const rail = this.querySelector<HTMLElement>('[data-player-context-rail]');
      return Boolean(rail && !rail.hidden && window.matchMedia('(min-width: 901px)').matches);
    }

    togglePlayerRailThreadMenu(threadIds: string[]) {
      const menu = this.querySelector<HTMLElement>('[data-player-rail-thread-menu]');
      if (!menu) return;
      if (!menu.hidden) {
        this.closePlayerRailThreadMenu(true);
        return;
      }
      this.openPlayerRailThreadMenu(threadIds);
    }

    openPlayerRailThreadMenu(threadIds: string[]) {
      const menu = this.querySelector<HTMLElement>('[data-player-rail-thread-menu]');
      const list = this.querySelector<HTMLElement>('[data-player-rail-thread-list]');
      const count = this.querySelector<HTMLElement>('[data-player-rail-thread-count]');
      const trigger = this.querySelector<HTMLElement>('[data-player-rail-thread]');
      if (!menu || !list || threadIds.length < 2) return;
      list.replaceChildren();
      for (const threadId of threadIds) {
        const detail = this.querySelector<HTMLElement>(`[data-thread-detail="${CSS.escape(threadId)}"]`);
        const title = detail?.querySelector('h2')?.textContent?.trim() || threadId;
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.playerRailThreadOption = threadId;
        button.textContent = `${title} →`;
        list.append(button);
      }
      if (count) count.textContent = `${threadIds.length} 条`;
      menu.hidden = false;
      trigger?.setAttribute('aria-expanded', 'true');
      window.requestAnimationFrame(() => list.querySelector<HTMLElement>('button')?.focus({ preventScroll: true }));
    }

    closePlayerRailThreadMenu(focus: boolean) {
      const menu = this.querySelector<HTMLElement>('[data-player-rail-thread-menu]');
      const trigger = this.querySelector<HTMLElement>('[data-player-rail-thread]');
      if (menu) menu.hidden = true;
      trigger?.setAttribute('aria-expanded', 'false');
      if (focus) trigger?.focus({ preventScroll: true });
    }

    openThreadFromPlayerRail(threadId: string) {
      const trigger = this.querySelector<HTMLElement>('[data-player-rail-thread]');
      if (this.selectedPersonId) this.closePerson(false);
      if (this.selectedThreadId) this.closeThread(false);
      this.closeSearch(false);
      this.openThread(threadId, trigger, true);
    }

    selectEvent(eventId: string, push: boolean, seek: boolean) {
      const event = this.data.events[eventId];
      if (!event) return;
      this.selectedEventId = eventId;
      this.activeTrackId = event.trackId;
      this.classList.add('has-active-event');
      this.updateTrack(event.trackId);
      this.querySelectorAll<HTMLElement>('[data-event-card]').forEach((card) => card.classList.toggle('is-active', card.dataset.eventCard === eventId));
      const current = this.querySelector<HTMLElement>('[data-player-current]');
      if (current) current.textContent = `TARGET · ${this.formatArchiveTime(event.startMs)}\n${event.title}`;
      this.updatePlayerTime(event.startMs);
      this.updateFallback(event);
      this.updatePlayerContext(event);
      if (push) this.updateUrl();
      if (seek) this.seekTo(event.startMs);
    }

    switchTrack(trackId: string, push: boolean) {
      const track = this.data.tracks[trackId];
      if (!track) return;
      this.selectedEventId = null;
      this.pendingSeekMs = null;
      this.classList.remove('has-active-event');
      this.activeTrackId = trackId;
      this.updateTrack(trackId);
      this.updateSourceEventIndex(trackId);
      this.querySelectorAll<HTMLElement>('[data-event-card]').forEach((card) => card.classList.remove('is-active'));
      const current = this.querySelector<HTMLElement>('[data-player-current]');
      if (current) current.textContent = track.playback.provider === 'external'
        ? 'NO TARGET SELECTED\n选择一个此来源事件以获得定位时间'
        : '选择时间节点开始定位';
      this.updatePlayerTime(null);
      this.updateFallback(null);
      this.updatePlayerContext(null);
      if (push) this.updateUrl();
    }

    showSourceEventIndex(trackId: string) {
      if (!this.data.tracks[trackId]) return;
      this.sourceEventsOpen = true;
      this.updateSourceEventIndex(trackId);
    }

    updateSourceEventIndex(trackId: string) {
      const index = this.querySelector<HTMLElement>('[data-source-event-index]');
      if (!index) return;
      index.hidden = !this.sourceEventsOpen;
      this.querySelectorAll<HTMLElement>('[data-source-event-list]').forEach((list) => {
        list.hidden = list.dataset.sourceEventList !== trackId || !this.sourceEventsOpen;
      });
      this.querySelectorAll<HTMLElement>('[data-source-browse]').forEach((button) => {
        button.setAttribute('aria-expanded', String(this.sourceEventsOpen && button.dataset.sourceBrowse === trackId));
      });
      const heading = this.querySelector<HTMLElement>('[data-source-event-heading]');
      if (heading) heading.textContent = `${this.data.tracks[trackId]?.label || '来源'} · 事件索引`;
    }

    openThread(threadId: string, trigger: HTMLElement | null, push: boolean) {
      const detail = this.querySelector(`[data-thread-detail="${CSS.escape(threadId)}"]`);
      if (!detail) return;
      this.returnFocus = trigger;
      this.selectedThreadId = threadId;
      this.querySelectorAll<HTMLElement>('[data-thread-detail]').forEach((item) => { item.hidden = item.dataset.threadDetail !== threadId; });
      const overlay = this.querySelector<HTMLElement>('[data-thread-overlay]');
      if (overlay) overlay.hidden = false;
      this.updateModalBackgroundInert();
      this.lockPage();
      this.querySelector<HTMLElement>('[data-thread-panel]')?.focus();
      this.updatePlayerRailActiveState();
      if (push) this.updateUrl();
    }

    closeThread(update: boolean) {
      if (!this.selectedThreadId) return;
      this.selectedThreadId = null;
      const overlay = this.querySelector<HTMLElement>('[data-thread-overlay]');
      if (overlay) overlay.hidden = true;
      this.updateModalBackgroundInert();
      this.unlockPage();
      this.returnFocus?.focus({ preventScroll: true });
      this.updatePlayerRailActiveState();
      if (update) this.replaceUrl();
    }

    openPerson(personId: string, trigger: HTMLElement | null, push: boolean) {
      const detail = this.querySelector(`[data-person-detail="${CSS.escape(personId)}"]`);
      if (!detail) return;
      this.returnFocus = trigger;
      this.selectedPersonId = personId;
      this.querySelectorAll<HTMLElement>('[data-person-detail]').forEach((item) => { item.hidden = item.dataset.personDetail !== personId; });
      const overlay = this.querySelector<HTMLElement>('[data-person-overlay]');
      if (overlay) overlay.hidden = false;
      this.updateModalBackgroundInert();
      this.lockPage();
      this.querySelector<HTMLElement>('[data-person-panel]')?.focus();
      if (push) this.updateUrl();
    }

    closePerson(update: boolean) {
      if (!this.selectedPersonId) return;
      this.selectedPersonId = null;
      const overlay = this.querySelector<HTMLElement>('[data-person-overlay]');
      if (overlay) overlay.hidden = true;
      this.updateModalBackgroundInert();
      this.unlockPage();
      this.returnFocus?.focus({ preventScroll: true });
      if (update) this.replaceUrl();
    }

    updateModalBackgroundInert() {
      const modalOpen = Boolean(this.selectedThreadId || this.selectedPersonId);
      this.querySelectorAll<HTMLElement>(':scope > *').forEach((child) => {
        if (child.matches('[data-thread-overlay], [data-person-overlay], script')) return;
        child.inert = modalOpen;
      });
    }

    trapModalFocus(event: KeyboardEvent) {
      const dialog = this.querySelector<HTMLElement>(this.selectedPersonId ? '[data-person-panel]' : '[data-thread-panel]');
      if (!dialog) return;
      const focusable = [...dialog.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )].filter((element) => !element.hidden && element.getAttribute('aria-hidden') !== 'true');
      if (focusable.length === 0) {
        event.preventDefault();
        dialog.focus();
        return;
      }
      const first = focusable[0];
      const last = focusable.at(-1);
      const active = document.activeElement;
      if (event.shiftKey && (active === first || !dialog.contains(active))) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    }

    lockPage() {
      if (document.body.classList.contains('archive-panel-open')) return;
      this.lockedScrollY = window.scrollY;
      this.lockedBodyPaddingRight = document.body.style.paddingRight;
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.body.classList.add('archive-panel-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${this.lockedScrollY}px`;
      document.body.style.width = '100%';
      if (scrollbarWidth > 0) document.body.style.paddingRight = `${scrollbarWidth}px`;
    }

    unlockPage() {
      document.body.classList.remove('archive-panel-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.style.paddingRight = this.lockedBodyPaddingRight;
      // The site enables smooth scrolling globally. Panel restoration must be
      // imperceptible, otherwise closing a detail visibly travels from page
      // top back to the trigger position.
      const previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, this.lockedScrollY);
      requestAnimationFrame(() => {
        document.documentElement.style.scrollBehavior = previousScrollBehavior;
      });
    }

    updateUrl() {
      this.writeUrl('push');
    }

    replaceUrl() {
      this.writeUrl('replace');
    }

    writeUrl(mode: 'push' | 'replace') {
      const url = new URL(window.location.href);
      url.searchParams.set('view', this.activeView);
      if (this.selectedEventId) url.searchParams.set('event', this.selectedEventId);
      else url.searchParams.delete('event');
      if (!this.selectedEventId && this.activeTrackId !== this.data.defaultTrackId) url.searchParams.set('track', this.activeTrackId);
      else url.searchParams.delete('track');
      if (this.selectedThreadId) url.searchParams.set('thread', this.selectedThreadId);
      else url.searchParams.delete('thread');
      if (this.selectedPersonId) url.searchParams.set('person', this.selectedPersonId);
      else url.searchParams.delete('person');
      if (mode === 'replace') history.replaceState({}, '', url);
      else history.pushState({}, '', url);
    }

    restoreFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const view = params.get('view') || this.data.defaultView;
      this.selectedEventId = null;
      this.selectedThreadId = null;
      this.selectedPersonId = null;
      this.activeTrackId = this.data.defaultTrackId;
      this.pendingSeekMs = null;
      this.returnFocus = null;
      this.classList.remove('has-active-event');
      this.querySelectorAll<HTMLElement>('[data-event-card]').forEach((card) => card.classList.remove('is-active'));
      this.updatePlayerTime(null);
      this.updatePlayerContext(null);
      this.updateFallback(null);
      this.querySelectorAll<HTMLElement>('[data-thread-detail]').forEach((item) => { item.hidden = true; });
      this.querySelectorAll<HTMLElement>('[data-person-detail]').forEach((item) => { item.hidden = true; });
      this.querySelector<HTMLElement>('[data-thread-overlay]')?.setAttribute('hidden', '');
      this.querySelector<HTMLElement>('[data-person-overlay]')?.setAttribute('hidden', '');
      if (document.body.classList.contains('archive-panel-open')) this.unlockPage();
      this.updateModalBackgroundInert();
      this.showView(view, false);
      const eventId = params.get('event');
      if (eventId && this.data.events[eventId]) {
        this.selectEvent(eventId, false, false);
      }
      else {
        const trackId = params.get('track');
        if (trackId && this.data.tracks[trackId]) this.switchTrack(trackId, false);
        else this.updateTrack(this.data.defaultTrackId);
      }
      const threadId = params.get('thread');
      const personId = params.get('person');
      if (threadId) this.openThread(threadId, null, false);
      if (personId) this.openPerson(personId, null, false);
      this.replaceUrl();
    }

    async ensurePlayer() {
      if (this.player) return this.player;
      const track = this.data.tracks[this.activeTrackId];
      if (!track || track.playback.provider !== 'youtube') return null;
      const mount = this.querySelector<HTMLElement>('[data-player-mount]');
      if (!mount) return null;
      try {
        const YT = await loadYouTubeApi();
        this.querySelector<HTMLElement>('[data-player-poster]')?.setAttribute('hidden', '');
        this.querySelector<HTMLElement>('[data-load-player]')?.setAttribute('hidden', '');
        this.player = new YT.Player(mount, {
          width: '100%',
          height: '100%',
          videoId: track.playback.videoId,
          playerVars: { playsinline: 1, rel: 0, origin: window.location.origin },
          events: {
            onReady: () => {
              this.playerReady = true;
              if (this.pendingSeekMs !== null) {
                const seekMs = this.pendingSeekMs;
                this.pendingSeekMs = null;
                this.player.seekTo(seekMs / 1000, true);
                this.player.playVideo();
              }
            },
            onStateChange: (playerEvent: any) => {
              if (playerEvent.data === YT.PlayerState.PLAYING) this.startPlaybackSync();
              else {
                this.syncFromPlayer();
                this.stopPlaybackSync();
              }
            },
          },
        });
        return this.player;
      } catch {
        const current = this.querySelector<HTMLElement>('[data-player-current]');
        if (current) current.textContent = '播放器载入失败，请使用下方带时间外链';
        return null;
      }
    }

    async seekTo(milliseconds: number) {
      this.pendingSeekMs = milliseconds;
      if (this.playerReady && this.player) {
        this.pendingSeekMs = null;
        this.player.seekTo(milliseconds / 1000, true);
        this.player.playVideo();
        return;
      }
      await this.ensurePlayer();
    }

    startPlaybackSync() {
      this.stopPlaybackSync();
      this.syncFromPlayer();
      this.playbackSyncTimer = window.setInterval(() => this.syncFromPlayer(), 750);
    }

    stopPlaybackSync() {
      if (this.playbackSyncTimer === null) return;
      window.clearInterval(this.playbackSyncTimer);
      this.playbackSyncTimer = null;
    }

    syncFromPlayer() {
      if (!this.playerReady || !this.player?.getCurrentTime) return;
      if (this.data.tracks[this.activeTrackId]?.playback.provider !== 'youtube') return;
      const currentMs = Math.max(0, Math.floor(this.player.getCurrentTime() * 1000));
      this.updatePlayerTime(currentMs);

      const eventAtTime = Object.entries(this.data.events)
        .filter(([, event]) => event.trackId === this.activeTrackId && event.startMs <= currentMs)
        .sort(([leftId, left], [rightId, right]) => right.startMs - left.startMs || leftId.localeCompare(rightId))[0];
      if (!eventAtTime || eventAtTime[0] === this.selectedEventId) return;

      const currentUrl = new URL(window.location.href);
      const urlHasEvent = currentUrl.searchParams.has('event');
      if (!urlHasEvent && this.activeView !== 'timeline') return;

      this.selectEvent(eventAtTime[0], false, false);
      // selectEvent shows the anchor time. While playback is active the clock
      // should continue to reflect the player's actual position.
      this.updatePlayerTime(currentMs);
      this.replaceUrl();
    }

    updateTrack(trackId: string) {
      const track = this.data.tracks[trackId];
      if (!track) return;
      this.activeTrackId = trackId;
      const label = this.querySelector<HTMLElement>('[data-player-track-label]');
      if (label) label.textContent = track.label;
      this.querySelectorAll<HTMLElement>('[data-source-track]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.sourceTrack === trackId));
      });
      const viewport = this.querySelector<HTMLElement>('[data-player-viewport]');
      const unavailable = this.querySelector<HTMLElement>('[data-player-unavailable]');
      const note = this.querySelector<HTMLElement>('[data-player-note]');
      const isPlayable = track.playback.provider === 'youtube';
      this.classList.toggle('is-external-source', track.playback.provider === 'external');
      this.classList.toggle('is-youtube-source', track.playback.provider === 'youtube');
      this.updateSourceEventIndex(trackId);
      if (viewport) viewport.hidden = !isPlayable;
      if (unavailable) unavailable.hidden = isPlayable;
      if (unavailable && !isPlayable) {
        unavailable.textContent = track.playback.provider === 'external'
          ? 'X SPACE REPLAY · EXTERNAL SOURCE\n本站提供原来源入口，不重托管媒体，也不伪造时间定位。'
          : '此轨道目前没有公开播放源';
      }
      if (note) note.textContent = track.playback.provider === 'youtube'
        ? '使用 YouTube 原生 360°能力；移动设备的视角支持取决于 YouTube 与设备。'
        : track.playback.provider === 'external'
          ? 'EXTERNAL SOURCE · 站内不播放，不提供程序化 seek；点击上方链接打开 X 原始回放。'
          : '当前未登记公开播放源。';
      if (!isPlayable && this.playerReady && this.player?.pauseVideo) this.player.pauseVideo();
    }

    formatArchiveTime(milliseconds: number) {
      const total = Math.floor(milliseconds / 1000);
      const parts = [Math.floor(total / 3600), Math.floor((total % 3600) / 60), total % 60];
      return parts.map((part) => String(part).padStart(2, '0')).join(':');
    }

    updatePlayerTime(milliseconds: number | null) {
      if (milliseconds === null) {
        const target = this.querySelector<HTMLElement>('[data-player-time]');
        if (target) target.textContent = '—';
        return;
      }
      const target = this.querySelector<HTMLElement>('[data-player-time]');
      if (target) target.textContent = this.formatArchiveTime(milliseconds);
    }

    updateFallback(event: ArchiveEvent | null) {
      const track = this.data.tracks[event?.trackId || this.activeTrackId];
      const link = this.querySelector<HTMLAnchorElement>('[data-player-fallback]');
      if (!link) return;
      link.hidden = !track?.fallbackUrl;
      if (!track?.fallbackUrl) return;
      const url = new URL(track.fallbackUrl);
      if (track.playback.provider === 'youtube' && event) {
        url.searchParams.set('t', `${Math.floor(event.startMs / 1000)}s`);
        link.textContent = '在 YouTube 打开当前时间 ↗';
      } else {
        link.textContent = track.playback.provider === 'external' ? '打开 X 原始回放 ↗' : '在 YouTube 打开原来源 ↗';
      }
      link.href = url.toString();
    }

    updatePlayerContext(event: ArchiveEvent | null) {
      const context = this.querySelector<HTMLElement>('[data-player-context]');
      const summary = this.querySelector<HTMLElement>('[data-player-context-summary]');
      const cta = this.querySelector<HTMLButtonElement>('[data-player-context-cta]');
      const threads = this.querySelector<HTMLElement>('[data-player-context-threads]');
      const list = this.querySelector<HTMLElement>('[data-player-context-thread-list]');
      if (!context || !summary || !cta || !threads) return;
      if (!event) {
        context.hidden = true;
        threads.hidden = true;
        list?.replaceChildren();
        this.updatePlayerRail(null);
        return;
      }

      const track = this.data.tracks[event.trackId];
      const archiveContext = this.getEventArchiveContext(event.id);
      context.hidden = false;
      threads.hidden = true;
      list?.replaceChildren();
      if (event.trackId === this.data.defaultTrackId) {
        summary.textContent = archiveContext.actLabel && archiveContext.actTitle
          ? `${archiveContext.actLabel} · ${archiveContext.actTitle}`
          : 'Timeline · YouTube 主直播';
        cta.textContent = '在 Timeline 查看此节点 →';
      } else {
        const threadCount = archiveContext.threadIds.length;
        summary.textContent = `${track?.shortLabel || 'External Source'} · ${threadCount ? `${threadCount} 条 Storyline 上下文` : '暂无 Storyline 上下文'}`;
        cta.textContent = threadCount === 0
          ? '在来源事件索引中查看 →'
          : threadCount > 1
          ? '在 Storyline 选择上下文 →'
          : '在 Storyline 查看上下文 →';
      }
      this.updatePlayerRail(event, archiveContext);
    }

    updatePlayerRail(event: ArchiveEvent | null, archiveContext?: EventArchiveContext) {
      const rail = this.querySelector<HTMLElement>('[data-player-context-rail]');
      const node = this.querySelector<HTMLButtonElement>('[data-player-rail-node]');
      const act = this.querySelector<HTMLButtonElement>('[data-player-rail-act]');
      const actLabel = this.querySelector<HTMLElement>('[data-player-rail-act-label]');
      const thread = this.querySelector<HTMLButtonElement>('[data-player-rail-thread]');
      const source = this.querySelector<HTMLAnchorElement>('[data-player-rail-source]');
      if (!rail || !node || !act || !actLabel || !thread || !source) return;
      this.closePlayerRailThreadMenu(false);
      if (!event) {
        rail.hidden = true;
        return;
      }

      const context = archiveContext || this.getEventArchiveContext(event.id);
      const track = this.data.tracks[event.trackId];
      const fallback = this.querySelector<HTMLAnchorElement>('[data-player-fallback]');
      rail.hidden = false;
      rail.dataset.playerRailEvent = event.id;
      node.setAttribute('aria-label', `在档案中查看当前节点：${event.title}`);

      const hasAct = event.trackId === this.data.defaultTrackId && Boolean(context.actId);
      act.disabled = !hasAct;
      actLabel.textContent = context.actLabel?.replace(/^ACT\s+/i, 'A') || 'ACT';
      act.setAttribute('aria-label', hasAct
        ? `${context.actLabel}：${context.actTitle || '定位当前章节'}`
        : '当前节点没有可用章节');

      const threadCount = context.threadIds.length;
      thread.disabled = threadCount === 0;
      thread.setAttribute('aria-label', threadCount
        ? `查看当前节点的 ${threadCount} 条事件线`
        : '当前节点没有事件线');

      source.hidden = !fallback || fallback.hidden;
      if (!source.hidden && fallback) source.href = fallback.href;
      source.setAttribute('aria-label', track?.playback.provider === 'external'
        ? '打开当前节点的 X 原始回放'
        : '在 YouTube 打开当前节点时间');
      this.updatePlayerRailActiveState();
    }

    updatePlayerRailActiveState() {
      const event = this.selectedEventId ? this.data?.events[this.selectedEventId] : null;
      const node = this.querySelector<HTMLElement>('[data-player-rail-node]');
      const act = this.querySelector<HTMLElement>('[data-player-rail-act]');
      const thread = this.querySelector<HTMLElement>('[data-player-rail-thread]');
      node?.classList.toggle('is-current-destination', Boolean(event && (
        event.trackId === this.data.defaultTrackId ? this.activeView === 'timeline' : this.activeView === 'storylines'
      )));
      act?.classList.toggle('is-current-destination', Boolean(event && this.activeView === 'timeline'));
      thread?.classList.toggle('is-current-destination', Boolean(this.selectedThreadId));
    }
  }

  if (!customElements.get('project-archive-shell')) {
    customElements.define('project-archive-shell', ProjectArchiveShellElement);
  }
</script>
