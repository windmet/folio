---
export interface Props {
  people: any[];
}

const { people } = Astro.props;
const rows = ['岡田以蔵', '沖田総司', '武市半平太', '坂本龍馬', '土方歳三', '藤堂平助'];
const findPerson = (character: string, session: 'day' | 'night') => people.find((person) => (
  (person.data.participation || []).some((item: any) => (
    item.kind === 'ore-shiri-cast'
    && item.character === character
    && item.sessions?.includes(session)
  ))
));
---

<div class="cast-matrix-wrap cast-matrix-desktop">
  <table class="cast-matrix">
    <caption>《俺を知ってくれ！》2026 昼夜 Cast</caption>
    <thead>
      <tr><th scope="col">角色</th><th scope="col">昼</th><th scope="col">夜</th></tr>
    </thead>
    <tbody>
      {rows.map((character) => (
        <tr>
          <th scope="row">{character}</th>
          {(['day', 'night'] as const).map((session) => {
            const person = findPerson(character, session);
            return (
              <td>
                {person ? (
                  <button type="button" data-open-person={person.id.split('/').at(-1)}>
                    {person.data.displayName}
                  </button>
                ) : '—'}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="cast-matrix-medium" aria-label="《俺を知ってくれ！》2026 昼夜 Cast（中等桌面投影）">
  <p class="cast-matrix-medium__caption">《俺を知ってくれ！》2026 昼夜 Cast</p>
  <div class="cast-matrix-medium__list">
    {rows.map((character) => (
      <div class="cast-matrix-medium__row">
        <strong>{character}</strong>
        {(['day', 'night'] as const).map((session) => {
          const person = findPerson(character, session);
          const sessionLabel = session === 'day' ? '昼' : '夜';
          return (
            <div class="cast-matrix-medium__session">
              <span>{sessionLabel}</span>
              {person ? (
                <button type="button" data-open-person={person.id.split('/').at(-1)} aria-label={`${character} ${sessionLabel} ${person.data.displayName}`}>
                  {person.data.displayName}
                </button>
              ) : <span>—</span>}
            </div>
          );
        })}
      </div>
    ))}
  </div>
</div>

<div class="cast-matrix-mobile" aria-label="《俺を知ってくれ！》2026 昼夜 Cast">
  <p class="cast-matrix-mobile__caption">《俺を知ってくれ！》2026 昼夜 Cast</p>
