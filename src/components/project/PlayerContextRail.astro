---
export interface Props {
  showStorylineAction?: boolean;
}

const { showStorylineAction = true } = Astro.props;
---

<nav class:list={['player-context-rail', 'player-action-bar', { 'has-storyline-action': showStorylineAction }]} data-player-context-rail hidden aria-label="当前节点操作">
  <button type="button" data-player-rail-node aria-label="在 Timeline 定位当前节点">
    <span data-player-rail-timeline-label>查看时间线</span>
  </button>
  {showStorylineAction && <div class="player-context-rail__thread-slot">
    <button
      type="button"
      data-player-rail-thread
      disabled
      aria-label="当前节点没有故事线"
      aria-expanded="false"
      aria-controls="player-context-rail-thread-menu"
    >
      <span data-player-rail-thread-label>故事线 · —</span>
    </button>
    <section
      class="player-context-rail__menu"
      id="player-context-rail-thread-menu"
      data-player-rail-thread-menu
      aria-label="相关事件线"
      hidden
    >
      <header>
        <span class="archive-kicker">RELATED STORYLINES</span>
        <strong data-player-rail-thread-count></strong>
      </header>
      <div data-player-rail-thread-list></div>
    </section>
  </div>}
  <a
    data-player-rail-source
    data-external-youtube-handoff
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="打开当前节点来源"
  >
    <span data-player-rail-source-label>YouTube ↗</span>
  </a>
</nav>
