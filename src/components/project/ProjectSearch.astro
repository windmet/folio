---
export interface Props {
  projectSlug: string;
  hasStorylines?: boolean;
  hasPeople?: boolean;
  placeholder?: string;
}

const { projectSlug, hasStorylines = false, hasPeople = false, placeholder = '输入姓名、作品或主题' } = Astro.props;
const endpoint = `/projects/${projectSlug}/search.json`;
const searchableKinds = ['事件', ...(hasStorylines ? ['事件线'] : []), ...(hasPeople ? ['人物'] : [])];
const searchLabel = hasStorylines && hasPeople
  ? '搜索事件、事件线或人物'
  : `搜索${searchableKinds.join('、')}`;
const scopeLabel = hasStorylines && hasPeople
  ? '只搜索已经公开的事件、故事线和人物'
  : `只搜索已经公开的${searchableKinds.join('、')}`;
---

<section class="project-search" role="search" aria-label="搜索专题档案" data-search-shell data-search-endpoint={endpoint}>
  <div class="project-search__field">
    <label for="project-archive-search">{searchLabel}</label>
    <input
      id="project-archive-search"
      type="text"
      role="searchbox"
      placeholder={placeholder}
      autocomplete="off"
      aria-controls="project-search-results"
      aria-expanded="false"
      data-archive-search
    />
    <button type="button" data-search-clear hidden aria-label="清除搜索">×</button>
  </div>

  <p class="project-search__status" data-search-status role="status" aria-live="polite">首次输入时加载公开索引。</p>
  <p class="project-search__error" data-search-error role="alert" hidden>搜索索引暂时无法载入，专题其余内容仍可继续浏览。</p>

  <div class="project-search__results" id="project-search-results" data-search-results hidden>
    <header>
      <strong data-search-count>0 条结果</strong>
      <span>{scopeLabel}</span>
    </header>
    <div class="project-search__list" data-search-list></div>
    <p class="project-search__empty" data-search-empty hidden>没有找到公开索引中的匹配项。</p>
  </div>
</section>
