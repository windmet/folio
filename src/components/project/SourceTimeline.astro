---
import TimelineEvent from './TimelineEvent.astro';

export interface Props {
  track: any;
  events: any[];
  peopleById: Map<string, any>;
  threadsByEvent: Map<string, string[]>;
  threadsById: Map<string, any>;
}

const { track, events, peopleById, threadsByEvent, threadsById } = Astro.props;
const localTrackId = track.id.split('/').at(-1) || track.id;
const formatDuration = (milliseconds: number) => {
  const total = Math.max(0, Math.floor(milliseconds / 1000));
  const parts = [Math.floor(total / 3600), Math.floor((total % 3600) / 60), total % 60];
  return parts.map((part) => String(part).padStart(2, '0')).join(':');
};
---

<section
  class="source-timeline"
  id={`timeline-scope-panel-${localTrackId}`}
  data-timeline-scope-panel={localTrackId}
  hidden
  aria-hidden="true"
  aria-labelledby={`timeline-scope-title-${localTrackId}`}
>
  <header class="source-timeline__header">
    <div>
      <span class="archive-kicker">{track.data.shortLabel} · NATIVE CLOCK</span>
      <h3 id={`timeline-scope-title-${localTrackId}`}>{track.data.label}</h3>
    </div>
    <div class="source-timeline__facts" aria-label="来源时间线摘要">
      <span>{events.length} 个事件</span>
      <span>{formatDuration(track.data.durationMs)}</span>
    </div>
    <p>本来源使用独立本地时钟；以下时间不会换算到 YouTube 主直播轴。</p>
  </header>
  <div class="source-timeline__events">
    {events.map((event) => (
      <TimelineEvent
        event={event}
        people={event.data.people.map((reference: any) => peopleById.get(reference.id)).filter(Boolean)}
        threadIds={threadsByEvent.get(event.id) || []}
        threadsById={threadsById}
      />
    ))}
  </div>
</section>
