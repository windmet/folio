---
const { cnSlug, jpSlug } = Astro.props;
---

<div class="lang-switcher" id="lang-switcher">
  <a href={cnSlug}>中文</a>
  <a href={jpSlug}>原文</a>
</div>

<script is:inline>
  (function() {
    var el = document.getElementById('lang-switcher');
    if (!el) return;
    var ticking = false;
    document.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          el.classList.toggle('is-scrolled', window.scrollY > 80);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>