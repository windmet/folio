---
export interface Props {
  date: string;
  type: 'event' | 'tweet' | 'video' | 'note';
  title?: string;
  jp?: string;
  url?: string;
}

const { date, type, title, jp, url } = Astro.props;
---

<div class="timeline-item">
  <div class="timeline-marker">
    <div class="timeline-dot"></div>
    <time class="timeline-date">{date}</time>
  </div>
  <div class="timeline-body">
    {title && <h3 class="timeline-title">{title}</h3>}
    <div class="timeline-content">
      <slot />
    </div>
    {jp && <p class="timeline-jp">{jp}</p>}
    {url && (
      <a href={url} class="timeline-url" target="_blank" rel="noopener noreferrer">
        {type === 'tweet' ? 'X で見る →' : '開く →'}
      </a>
    )}
  </div>
</div>

<style>
  .timeline-item {
    position: relative;
    padding-left: 100px;
    padding-bottom: 40px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  /* 左侧竖线 */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 24px;
    bottom: 0;
    width: 1px;
    background: #e7e5e4;
  }

  .timeline-item:last-child::before {
    display: none;
  }

  .timeline-marker {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 40px;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #d4cfc8;
    border: 3px solid #fafaf9;
    flex-shrink: 0;
    z-index: 1;
  }

  .timeline-date {
    font-size: 11px;
    color: #a8a29e;
    letter-spacing: 0.05em;
    font-family: 'SF Mono', Consolas, monospace;
    white-space: nowrap;
    position: absolute;
    left: 24px;
    top: 2px;
    width: 80px;
  }

  .timeline-body {
    border-left: 1px solid #f0edeb;
    padding-left: 32px;
  }

  .timeline-title {
    font-size: 15px;
    font-weight: 600;
    color: #444;
    margin: 0 0 6px 0;
    line-height: 1.5;
    font-family: 'Noto Serif SC', 'Noto Serif JP', Georgia, serif;
  }

  .timeline-content {
    font-size: 14px;
    line-height: 1.8;
    color: #57534e;
  }

  .timeline-content :global(p) {
    margin: 0 0 6px 0;
  }

  .timeline-jp {
    font-size: 13px;
    line-height: 1.7;
    color: #a8a29e;
    margin: 8px 0 0 0;
  }

  .timeline-url {
    display: inline-block;
    margin-top: 8px;
    font-size: 12px;
    color: #a8a29e;
    text-decoration: none;
    border-bottom: 1px solid #e7e5e4;
    transition: color 0.2s, border-color 0.2s;
  }

  .timeline-url:hover {
    color: #57534e;
    border-color: #a8a29e;
  }

  @media (max-width: 640px) {
    .timeline-item {
      padding-left: 72px;
    }
    .timeline-date {
      width: 52px;
      font-size: 10px;
    }
  }
</style>
