---
import {
  resolveCanonical,
  resolvePageTitle,
  resolveRobots,
  SITE_DEFAULT_DESCRIPTION,
  SITE_NAME,
} from '../lib/siteMetadata';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
}

const { title, description, robots, ogType = 'website', canonical: canonicalOverride } = Astro.props;
const pageTitle = resolvePageTitle(title);
const pageDescription = description || SITE_DEFAULT_DESCRIPTION;
const canonical = resolveCanonical(Astro.url.pathname, Astro.site, canonicalOverride);
const robotsContent = resolveRobots(Astro.url.pathname, robots);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={pageDescription} />
<meta name="robots" content={robotsContent} />
<meta name="theme-color" content="#f7f4ef" />
{canonical && <link rel="canonical" href={canonical} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:type" content={ogType} />
{canonical && <meta property="og:url" content={canonical} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Serif+JP:wght@400;600;700&display=swap" rel="stylesheet" />
<title>{pageTitle}</title>
