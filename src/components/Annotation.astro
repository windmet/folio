---
export interface Props {
  content: string;
}
const { content } = Astro.props;
---
<aside class="author-note">
  <svg class="author-note-pin" viewBox="0 0 12 12" fill="none" width="12" height="12">
    <circle cx="6" cy="6" r="5.5" stroke="currentColor"/><circle cx="6" cy="6" r="1.5" fill="currentColor"/>
  </svg>
  <p class="author-note-text">{content}</p>
</aside>