---
export interface Props {
  repo: string;
  repoId: string;
  term: string;
}

const { repo, repoId, term } = Astro.props;
---

<div class="reactions-panel not-prose mt-12 pt-8 border-t border-stone-100" data-term={term}>
  <div class="text-xs text-stone-400 mb-4 tracking-widest uppercase font-sans">表情反应</div>
  <div class="flex gap-2 flex-wrap" id="reactions-container">
    <span class="text-xs text-stone-400" id="reactions-loading">加载中…</span>
  </div>
</div>

<script>
  const EMOJI_MAP = [
    { content: "thumbs_up",   emoji: "👍", label: "赞" },
    { content: "thumbs_down", emoji: "👎", label: "踩" },
    { content: "laugh",      emoji: "😄", label: "好笑" },
    { content: "hooray",     emoji: "🎉", label: "欢呼" },
    { content: "confused",   emoji: "😕", label: "困惑" },
    { content: "heart",      emoji: "❤️", label: "喜欢" },
    { content: "rocket",     emoji: "🚀", label: "火箭" },
    { content: "eyes",       emoji: "👀", label: "围观" },
  ];

  const panel = document.querySelector<HTMLElement>('.reactions-panel');
  if (!panel) throw new Error('no panel');

  const term = panel.dataset.term!;
  const container = document.getElementById('reactions-container')!;
  const loading = document.getElementById('reactions-loading')!;

  // 本地存储 key（防止同一页面重复点赞）
  const localKey = `r-${term}`;
  const voted: Set<string> = new Set(
    JSON.parse(localStorage.getItem(localKey) || '[]')
  );

  async function load() {
    try {
      const res = await fetch(`/api/reactions?term=${encodeURIComponent(term)}`);
      if (!res.ok) throw new Error();
      const counts: Record<string, number> = await res.json();
      loading.remove();
      EMOJI_MAP.forEach(m => {
        const btn = document.createElement('button');
        const count = counts[m.content] || 0;
        const isVoted = voted.has(m.content);

        btn.className = [
          're-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-sm',
          'border-stone-200 text-stone-500 hover:border-stone-400 hover:text-stone-700',
          isVoted ? 'border-stone-400 bg-stone-100 text-stone-800' : '',
        ].join(' ');

        btn.innerHTML = `<span>${m.emoji}</span><span class="text-xs">${count}</span>`;
        btn.addEventListener('click', () => toggle(m.content, btn, counts));
        container.appendChild(btn);
      });
    } catch {
      loading.textContent = '表情加载失败';
    }
  }

  async function toggle(content: string, btn: HTMLButtonElement, counts: Record<string, number>) {
    const isVoted = voted.has(content);

    // 即时乐观更新
    counts[content] = (counts[content] || 0) + (isVoted ? -1 : 1);
    btn.querySelector('.text-xs')!.textContent = String(counts[content]);

    if (isVoted) {
      voted.delete(content);
      btn.classList.remove('border-stone-400', 'bg-stone-100', 'text-stone-800');
      btn.classList.add('border-stone-200', 'text-stone-500');
    } else {
      voted.add(content);
      btn.classList.add('border-stone-400', 'bg-stone-100', 'text-stone-800');
      btn.classList.remove('border-stone-200', 'text-stone-500');
    }
    localStorage.setItem(localKey, JSON.stringify([...voted]));

    try {
      const method = isVoted ? 'DELETE' : 'POST';
      const res = await fetch('/api/reactions', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ term, content }),
      });
      if (!res.ok) throw new Error();
      const updated: Record<string, number> = await res.json();
      Object.assign(counts, updated);
    } catch {
      // 回滚
      counts[content] = (counts[content] || 0) + (isVoted ? 1 : -1);
      btn.querySelector('.text-xs')!.textContent = String(counts[content]);
      if (isVoted) { voted.add(content); btn.classList.add('border-stone-400', 'bg-stone-100', 'text-stone-800'); }
      else { voted.delete(content); btn.classList.remove('border-stone-400', 'bg-stone-100', 'text-stone-800'); }
    }
  }

  load();
</script>

<style>
  .re-btn { cursor: pointer; }
</style>