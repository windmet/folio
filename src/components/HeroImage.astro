---
export interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="not-prose my-10">
  <div class="border border-stone-200 bg-white p-2 rounded-sm shadow-sm">
    <img
      src={src}
      alt={alt}
      class="w-full h-auto max-h-[70vh] object-contain mx-auto"
      loading="eager"
      decoding="async"
    />
  </div>
</figure>
