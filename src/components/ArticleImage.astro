---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="not-prose my-8">
  <img
    src={src}
    alt={alt}
    class="w-full h-auto max-h-[80vh] object-contain mx-auto rounded-md"
    loading="lazy"
    decoding="async"
  />
  {caption && (
    <figcaption class="text-center text-xs text-stone-400 mt-3 tracking-wide font-sans">
      {caption}
    </figcaption>
  )}
</figure>
