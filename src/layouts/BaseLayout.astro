---
import '../styles/global.css';
import SiteHead from '../components/SiteHead.astro';
import { SITE_BRAND, SITE_NAME } from '../lib/siteMetadata';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <SiteHead title={title} description={description} robots={robots} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="py-8 px-4 text-center relative">
      <a href="/" class="text-xs tracking-[0.3em] text-stone-400 no-underline hover:text-stone-600 transition-colors uppercase">
        {SITE_NAME}
      </a>
      <nav class="absolute right-4 top-1/2 -translate-y-1/2 hidden sm:block">
        <a href="/about/" class="text-xs tracking-wider text-stone-300 no-underline hover:text-stone-500 transition-colors mr-4">
          About
        </a>
        <a href="/timeline/" class="text-xs tracking-wider text-stone-300 no-underline hover:text-stone-500 transition-colors">
          Timeline
        </a>
      </nav>
    </header>

    <main class="flex-1 w-full max-w-prose mx-auto px-4">
      <article class="prose prose-stone prose-base max-w-none
        prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-wide
        prose-p:leading-loose prose-p:text-stone-800
        prose-a:text-stone-500 prose-a:no-underline hover:prose-a:text-stone-700
        prose-img:rounded-md prose-img:mx-auto
        prose-blockquote:border-stone-300 prose-blockquote:font-serif
        prose-figure:my-8">
        <slot />
      </article>
    </main>

    <footer class="py-8 text-center text-xs text-stone-300 tracking-widest">
      <p>&copy; {new Date().getFullYear()} · <a href="/about/" class="hover:text-stone-500">About</a> · Built with {SITE_BRAND}</p>
    </footer>
  </body>
</html>
