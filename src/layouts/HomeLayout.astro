---
import '../styles/global.css';
import '../styles/home.css';
import SiteHead from '../components/SiteHead.astro';
import { SITE_BRAND } from '../lib/siteMetadata';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN" class="home-root">
  <head>
    <SiteHead title={title} description={description} robots={robots} />
  </head>
  <body class="home-page">
    <header class="home-site-header">
      <a class="home-site-mark" href="/">GOMYAKU / 前情帖</a>
      <nav aria-label="站点导航">
        <a href="/#archives">档案</a>
        <a href="/people/">人物</a>
        <a href="/indexes/">索引</a>
        <a href="/about/">关于</a>
      </nav>
    </header>
    <slot />
    <footer class="home-site-footer">
      <p>Archive in progress - {new Date().getFullYear()} · <a href="/search/">搜索</a> · <a href="/about/">关于</a> · Built with {SITE_BRAND}</p>
    </footer>
  </body>
</html>
