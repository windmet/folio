---
import '../styles/global.css';
import '../styles/project.css';
import SiteHead from '../components/SiteHead.astro';
import { SITE_BRAND, SITE_NAME } from '../lib/siteMetadata';

export interface Props {
  title: string;
  description: string;
  visualTheme?: 'broadcast-blue';
  robots?: string;
}

const { title, description, visualTheme, robots } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <SiteHead title={title} description={description} robots={robots} ogType="article" />
  </head>
  <body class="project-page" data-archive-theme={visualTheme}>
    <header class="project-site-header">
      <a href="/" class="project-brand">{SITE_NAME}</a>
      <span>{SITE_NAME} · 声优活动专题档案</span>
      <nav aria-label="站点导航">
        <a href="/people/">People</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="project-footer">
      <p>Archive in progress · {new Date().getFullYear()} · <a href="/about/">About</a> · Built with {SITE_BRAND}</p>
    </footer>
  </body>
</html>
