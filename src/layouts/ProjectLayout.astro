---
import '../styles/global.css';
import '../styles/project.css';

export interface Props {
  title: string;
  description: string;
  visualTheme?: 'broadcast-blue';
}

const { title, description, visualTheme } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Serif+JP:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title} — Magazine</title>
  </head>
  <body class="project-page" data-archive-theme={visualTheme}>
    <header class="project-site-header">
      <a href="/" class="project-brand">Magazine</a>
      <span>声优活动专题档案</span>
    </header>
    <main>
      <slot />
    </main>
    <footer class="project-footer">
      <p>Archive in progress · {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>
