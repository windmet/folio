---
import '../styles/global.css';
import '../styles/indexes.css';
import SiteHead from '../components/SiteHead.astro';
import { SITE_BRAND, SITE_NAME } from '../lib/siteMetadata';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <SiteHead title={title} description={description} robots={robots} />
  </head>
  <body class="index-page">
    <header class="index-site-header">
      <a class="index-brand" href="/">{SITE_NAME}</a>
      <nav aria-label="站点导航">
        <a href="/#archives">档案</a>
        <a href="/people/">人物</a>
        <a href="/indexes/" aria-current="page">索引</a>
        <a href="/about/">关于</a>
      </nav>
    </header>
    <slot />
    <footer class="index-site-footer">
      <p>Archive in progress - {new Date().getFullYear()} · <a href="/search/">搜索</a> · Built with {SITE_BRAND}</p>
    </footer>
  </body>
</html>
