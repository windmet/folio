---
import '../styles/global.css';
import '../styles/people.css';
import SiteHead from '../components/SiteHead.astro';
import { SITE_BRAND, SITE_NAME } from '../lib/siteMetadata';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <SiteHead title={title} description={description} robots={robots} />
  </head>
  <body class="people-page">
    <header class="people-site-header">
      <a href="/" class="people-brand">{SITE_NAME}</a>
      <nav aria-label="站点导航">
        <a href="/#archives">档案</a>
        <a href="/people/" aria-current={title === 'People' ? 'page' : undefined}>人物</a>
        <a href="/indexes/">索引</a>
        <a href="/about/">关于</a>
      </nav>
    </header>
    <slot />
    <footer class="people-site-footer">
      <p>Archive in progress - {new Date().getFullYear()} · <a href="/search/">搜索</a> · <a href="/about/">关于</a> · Built with {SITE_BRAND}</p>
    </footer>
  </body>
</html>
