---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroImage from '../../components/HeroImage.astro';
import Giscus from '../../components/Giscus.astro';
import LangSwitcher from '../../components/LangSwitcher.astro';
import QuoteLine from '../../components/QuoteLine.astro';
import Question from '../../components/Question.astro';
import Annotation from '../../components/Annotation.astro';
import TweetEmbed from '../../components/TweetEmbed.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import Tweet from '../../components/Tweet.astro';
import Reply from '../../components/Reply.astro';
import QuoteTweet from '../../components/QuoteTweet.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const slug = post.id;
const isJP = !slug.endsWith('-cn');
const cnSlug = isJP ? `/posts/${slug}-cn/` : `/posts/${slug}/`;
const jpSlug = isJP ? `/posts/${slug}/` : `/posts/${slug.slice(0, -3)}/`;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <header class="not-prose mb-10 text-center">
    <time class="text-xs text-stone-300 tracking-widest">
      {post.data.date.toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      })}
    </time>
    <h1 class="text-xl font-serif font-normal text-stone-800 mt-3 mb-0 leading-relaxed tracking-wide">
      {post.data.title}
    </h1>
  </header>

  {post.data.heroImage && <HeroImage src={post.data.heroImage} alt={post.data.title} />}

  <Content components={{ QuoteLine, Question, Annotation, TweetEmbed, YouTubeEmbed, Tweet, Reply, QuoteTweet }} />

  <Giscus />

  <LangSwitcher cnSlug={cnSlug} jpSlug={jpSlug} />
</BaseLayout>

<script>
  document.addEventListener('click', (e) => {
    const img = e.target.closest('.tweet-content img, .qt-content img');
    if (img) img.classList.toggle('is-expanded');
  });
</script>

