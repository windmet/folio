---
import { getCollection } from 'astro:content';
import PeopleLayout from '../../layouts/PeopleLayout.astro';
import { buildGlobalPeopleProjection } from '../../lib/globalPeople';

const [identities, projects, contexts, events, indexes, sources] = await Promise.all([
  getCollection('people'),
  getCollection('projects'),
  getCollection('projectPeople'),
  getCollection('projectEvents'),
  getCollection('indexes'),
  getCollection('sources'),
]);
const people = buildGlobalPeopleProjection({ identities, projects, contexts, events, indexes, sources });
const contextCount = people.reduce((total, person) => total + person.contexts.length, 0);
const indexAppearanceCount = people.reduce((total, person) => total + person.indexAppearances.length, 0);
const boardPeople = [...people]
  .filter((person) => person.chronology.length > 0)
  .sort((left, right) => (right.relevance + right.projectCount + right.indexCount * 0.5)
    - (left.relevance + left.projectCount + left.indexCount * 0.5)
    || left.displayName.localeCompare(right.displayName, 'zh-CN'))
  .slice(0, 10)
  .map((person, index) => ({
    ...person,
    tier: index === 0 ? 'hero' : index <= 3 ? 'major' : index <= 7 ? 'mid' : 'compact',
  }));
const directoryPeople = [...people].sort((left, right) => left.displayName.localeCompare(right.displayName, 'ja'));
const stats = (person: any) => `${person.projectCount}P · ${person.indexCount}R · ${person.nodeCount}N`;
---

<PeopleLayout title="People" description="跨档案人物索引与项目、公开记录语境入口">
  <main class="people-shell">
    <header class="people-intro">
      <span class="people-kicker">GLOBAL PEOPLE INDEX</span>
      <h1>人物档案</h1>
      <p>先看反复出现在档案中的核心人物，再从完整目录进入每个人的跨档案语境。人物卡只概括“在哪些记录中出现”；具体事件和原始节点进入人物页后再按档案展开。</p>
      <div class="people-index-meta" aria-label="人物索引统计">
        <span>{people.length} PEOPLE</span>
        <span>{contextCount} PROJECT CONTEXTS</span>
        <span>{indexAppearanceCount} INDEX APPEARANCES</span>
      </div>
    </header>

    <section class="people-featured" aria-labelledby="people-featured-title">
      <div class="people-section-heading">
        <div>
          <span class="people-kicker">FEATURED PEOPLE</span>
          <h2 id="people-featured-title">主要人物</h2>
        </div>
        <p>面积只表达当前档案中的出现密度，不是人物重要性的永久排名。</p>
      </div>
      <div class="people-featured-board">
        {boardPeople.map((person) => (
          <a class:list={["featured-person-card", `featured-person-card--${person.tier}`]} href={`/people/${person.id}/`} data-featured-person={person.id} data-person-tier={person.tier}>
            <span class="person-card-kicker">{stats(person)}</span>
            <h3>{person.displayName}</h3>
            {person.reading && <p class="person-card-reading">{person.reading}</p>}
            {(person.tier === 'hero' || person.tier === 'major') && <p class="featured-person-summary">{person.contextSummary}</p>}
            {person.presence.length > 0 && <div class="person-chip-row" aria-label="主要出现方式">
              {person.presence.slice(0, person.tier === 'hero' ? 3 : 2).map((item) => <span class="person-chip">{item.label}</span>)}
            </div>}
          </a>
        ))}
      </div>
    </section>

    <section class="people-directory" aria-labelledby="people-directory-title">
      <div class="people-section-heading">
        <div>
          <span class="people-kicker">ALL PEOPLE</span>
          <h2 id="people-directory-title">完整目录</h2>
        </div>
        <p>{directoryPeople.length} 人 · 按显示名排列</p>
      </div>
      <div class="people-directory-list">
        {directoryPeople.map((person) => (
          <a class="directory-person" href={`/people/${person.id}/`} data-directory-person={person.id}>
            <span>
              <strong>{person.displayName}</strong>
              {person.reading && <small>{person.reading}</small>}
            </span>
            <span class="directory-person-meta">{stats(person)}</span>
            <span class="directory-person-presence">{person.presence.slice(0, 2).map((item) => item.label).join(' / ') || (person.indexCount ? '公开记录' : '身份记录')}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</PeopleLayout>
