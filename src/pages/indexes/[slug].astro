---
import { getCollection, getEntry } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import SourcePost from '../../components/sources/SourcePost.astro';

export async function getStaticPaths() {
  const indexes = await getCollection('indexes', ({ data }) => data.status === 'published');
  return indexes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const referenceId = (reference: any) => reference?.id || reference;
const people = await Promise.all(entry.data.entries.flatMap((item: any) => item.people || []).map((person: any) => getEntry(person)));
const peopleById = new Map(people.filter(Boolean).map((person: any) => [person.id, person]));
const sources = await Promise.all(entry.data.entries.map((item: any) => item.source ? getEntry(item.source) : null));
const sourcesById = new Map(sources.filter(Boolean).map((source: any) => [source.id, source]));
const projects = await Promise.all((entry.data.relatedProjects || []).map((project: any) => getEntry(project)));
const entrySortDate = (item: any) => item.source
  ? sourcesById.get(referenceId(item.source))?.data.publishedAt || item.date
  : item.date;
const defaultOrder = entry.data.chronology.defaultOrder;
const isSourceSequence = entry.data.presentation === 'source-sequence';
const orderedEntries = [...entry.data.entries].sort((left: any, right: any) => {
  const comparison = entrySortDate(left).localeCompare(entrySortDate(right), 'en');
  return defaultOrder === 'asc' ? comparison : -comparison;
});
const formatDate = (date: string) => date.replaceAll('-', '.');
const formatSequenceTime = (date: string) => new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Tokyo',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(date));
const kindLabels = {
  'program-series': '节目系列',
  'stage-series': '舞台系列',
  'public-record': '公开记录',
};
---
<IndexLayout title={entry.data.title} description={entry.data.summary}>
  <main class="index-shell index-detail">
    <nav class="index-breadcrumb" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href="/indexes/">索引</a><span>/</span><span>{entry.data.title}</span></nav>
    <header class="index-detail-header">
      <p class="index-kicker">{kindLabels[entry.data.kind]}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </header>

    <section class:list={["index-entry-list", { "index-entry-list--source-sequence": isSourceSequence }]} aria-labelledby="index-records-title" data-index-chronology data-default-order={defaultOrder}>
      <div class="index-section-heading">
        <div>
          <p class="index-kicker">CHRONOLOGY</p>
          <h2 id="index-records-title">公开记录</h2>
        </div>
        {entry.data.chronology.reversible && <div class="index-order-controls" role="group" aria-label="公开记录排序">
          <button type="button" data-index-order="desc" aria-pressed={String(defaultOrder === 'desc')}>新 → 旧</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-index-order="asc" aria-pressed={String(defaultOrder === 'asc')}>旧 → 新</button>
        </div>}
      </div>
      <div class="index-chronology chronology" data-index-chronology-list>
        {orderedEntries.map((item: any) => (
          <article class="index-entry chronology-item" id={item.id} data-entry-date={entrySortDate(item)}>
            <time class="index-entry-date chronology-date" datetime={entrySortDate(item)}>{isSourceSequence ? formatSequenceTime(entrySortDate(item)) : formatDate(item.date)}</time>
            <span class="index-entry-node chronology-node" aria-hidden="true"></span>
            <div>
              {!isSourceSequence && <span class="index-entry-year">{item.date.slice(0, 4)}</span>}
              {!isSourceSequence && <h3>{item.title}</h3>}
              {!isSourceSequence && item.summary && <p>{item.summary}</p>}
              {item.source && sourcesById.get(referenceId(item.source)) && <SourcePost source={sourcesById.get(referenceId(item.source)).data} showPublishedAt={!isSourceSequence} />}
              {!isSourceSequence && item.people.length > 0 && <div class="index-entry-people" aria-label="相关人物">
                {item.people.map((personRef: any) => {
                  const id = referenceId(personRef);
                  const person = peopleById.get(id);
                  return person && <a href={`/people/${id}/`}>{person.data.displayName}</a>;
                })}
              </div>}
              {item.links.length > 0 && <div class="index-entry-links">
                {item.links.map((link: any) => <a href={link.url} rel="noreferrer" target="_blank">{link.label} ↗</a>)}
              </div>}
            </div>
          </article>
        ))}
      </div>
    </section>

    {projects.filter(Boolean).length > 0 && <aside class="index-related" aria-labelledby="index-related-title">
      <h2 id="index-related-title">继续进入相关档案</h2>
      <div>
        {projects.filter(Boolean).map((project: any) => <a href={`/projects/${project.data.slug}/`}>{project.data.title} →</a>)}
      </div>
    </aside>}
  </main>
</IndexLayout>

<script>
  const chronology = document.querySelector<HTMLElement>('[data-index-chronology]');
  const list = chronology?.querySelector<HTMLElement>('[data-index-chronology-list]');
  chronology?.querySelectorAll<HTMLButtonElement>('[data-index-order]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!list) return;
      const direction = button.dataset.indexOrder === 'asc' ? 1 : -1;
      const nodes = [...list.querySelectorAll<HTMLElement>('[data-entry-date]')];
      nodes.sort((left, right) => direction * (left.dataset.entryDate || '').localeCompare(right.dataset.entryDate || '', 'en'));
      nodes.forEach((node) => list.append(node));
      chronology.querySelectorAll<HTMLButtonElement>('[data-index-order]').forEach((control) => {
        control.setAttribute('aria-pressed', String(control === button));
      });
    });
  });
</script>
