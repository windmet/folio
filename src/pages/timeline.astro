---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('timeline');
items.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="Timeline" description="考古时间线">
  <header class="not-prose mb-12 text-center">
    <h1 class="text-lg font-serif font-normal text-stone-800 tracking-wide m-0">
      Timeline
    </h1>
    <p class="text-xs text-stone-400 mt-2 m-0 tracking-wider">
      考古记录 · 演艺历程
    </p>
  </header>

  <Timeline items={items} />
</BaseLayout>
