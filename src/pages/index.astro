---
import { getCollection } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeMasthead from '../components/home/HomeMasthead.astro';
import FeaturedArchive from '../components/home/FeaturedArchive.astro';
import PeopleTeaser from '../components/home/PeopleTeaser.astro';
import RecentFeed from '../components/home/RecentFeed.astro';
import LegacyCollections from '../components/home/LegacyCollections.astro';
import IndexTeaser from '../components/home/IndexTeaser.astro';
import HomeScene from '../components/home/HomeScene.astro';
import { buildHomeProjection } from '../lib/homeProjection';

const [posts, projects, indexes, tracks, events, threads, identities, personContexts, indexPersonContexts] = await Promise.all([
  getCollection('posts'),
  getCollection('projects'),
  getCollection('indexes'),
  getCollection('projectTracks'),
  getCollection('projectEvents'),
  getCollection('projectThreads'),
  getCollection('people'),
  getCollection('projectPeople'),
  getCollection('indexPeople'),
]);
const projection = buildHomeProjection({
  posts,
  projects,
  indexes,
  tracks,
  events,
  threads,
  identities,
  personContexts,
  indexPersonContexts,
});
---

<HomeLayout title="前情帖" description="GOMYAKU 前情帖：Project、人物语境与旧文章入口">
  <main class="home-document">
    <HomeScene id="cover" tone="cover"><HomeMasthead /></HomeScene>
    <HomeScene id="archives" tone="archive">
      <FeaturedArchive projects={projection.projects} projectStats={projection.projectStats} />
    </HomeScene>
    <HomeScene id="people" tone="people"><PeopleTeaser people={projection.people} /></HomeScene>
    <HomeScene id="indexes" tone="index"><IndexTeaser indexes={projection.indexes} /></HomeScene>
    <div class="home-tail">
      <div class="home-tail-inner">
        <RecentFeed feed={projection.recentFeed} />
        {projection.posts.length > 0 && <LegacyCollections articleCollections={projection.articleCollections} />}
      </div>
    </div>
  </main>
</HomeLayout>
