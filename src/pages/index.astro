---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const projects = (await getCollection('projects'))
  .filter((project) => project.data.status === 'published')
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'));
const projectTracks = await getCollection('projectTracks');
const projectEvents = await getCollection('projectEvents');
const projectThreads = await getCollection('projectThreads');
const referenceId = (reference: any) => reference.id;

const folders = [
  {
    id: 'interview',
    color: '#f0fdf4',
    tabColor: '#d9f5e0',
    borderColor: '#d9f5e0',
    activeColor: '#6b9b7a',
    tab: 'Interview',
    title: '杂志采访烤肉',
    desc: '长篇对谈与杂志翻译存档',
    vol: 'ARCHIVE.VOL.01',
    icon: 'mic',
    match: (id: string) => id.includes('interview'),
  },
  {
    id: 'archive',
    color: '#fdf8f0',
    tabColor: '#f0e8d9',
    borderColor: '#f0e8d9',
    activeColor: '#b8956a',
    tab: 'Archive',
    title: '博文考古整理',
    desc: '早年推文考据与历史记录',
    vol: 'ARCHIVE.VOL.02',
    icon: 'search',
    match: (id: string) => id.includes('ancient') || id.includes('tweet') || id.includes('考古'),
  },
  {
    id: 'radio',
    color: '#f0f7fd',
    tabColor: '#d9e8f5',
    borderColor: '#d9e8f5',
    activeColor: '#6a8fad',
    tab: 'Radio',
    title: '电台内容存档',
    desc: '广播节目音声与放送回忆',
    vol: 'ARCHIVE.VOL.03',
    icon: 'radio',
    match: (id: string) => id.includes('radio') || id.includes('放送'),
  },
  {
    id: 'note',
    color: '#f8f0fd',
    tabColor: '#e8d9f5',
    borderColor: '#e8d9f5',
    activeColor: '#9a7aaf',
    tab: 'Note',
    title: '博主的碎碎念',
    desc: '个人杂谈与随性记录',
    vol: 'ARCHIVE.VOL.04',
    icon: 'coffee',
    match: (id: string) =>
      !id.includes('interview') && !id.includes('ancient') && !id.includes('tweet') &&
      !id.includes('radio') && !id.includes('放送') && !id.includes('考古'),
  },
];

const icons: Record<string, string> = {
  mic: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 13a7 7 0 0 0 14 0"/><line x1="12" y1="19" x2="12" y2="22"/></svg>',
  search: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/><line x1="8" y1="11" x2="14" y2="11"/></svg>',
  radio: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4.9 16.1C1 12.2 1 5.8 4.9 1.9"/><path d="M7.8 13.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 13.2c2.3-2.3 2.3-6.1 0-8.5"/><path d="M19.1 16.1c3.9-3.9 3.9-10.3 0-14.2"/></svg>',
  coffee: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>',
};
---

<BaseLayout title="资料室">
  <div class="index-header">
    <h1 class="index-title">资料室</h1>
    <p class="index-subtitle">冷门同好熟肉存档站 · 翻阅馆藏</p>
  </div>

  {projects.length > 0 && (
    <section class="project-shelf" aria-labelledby="project-shelf-title">
      <div class="project-shelf-heading">
        <h2 id="project-shelf-title">专题档案</h2>
        <span>PROJECT ARCHIVE</span>
      </div>
      {projects.map((project) => {
        const tracks = projectTracks.filter((track) => referenceId(track.data.project) === project.id).length;
        const events = projectEvents.filter((event) =>
          referenceId(event.data.project) === project.id && event.data.publicationStatus !== 'withheld').length;
        const threads = projectThreads.filter((thread) => referenceId(thread.data.project) === project.id).length;
        return (
          <a href={`/projects/${project.data.slug}/`} class="project-folder">
            <span class="project-folder-tab">Project</span>
            <div class="project-folder-body">
              <div class="project-folder-main">
                <span class="project-folder-kicker">持续整理中 · MULTI-TRACK EVENT</span>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
              </div>
              <div class="project-folder-meta" aria-label="专题内容统计">
                <strong>{events}</strong><span>EVENTS</span>
                <strong>{threads}</strong><span>THREADS</span>
                <strong>{tracks}</strong><span>TRACKS</span>
              </div>
              <span class="project-folder-enter">进入专题档案 →</span>
              {project.data.mark && <span class="project-folder-mark" aria-hidden="true">{project.data.mark}</span>}
            </div>
          </a>
        );
      })}
    </section>
  )}

  <div class="folder-grid">
    {folders.map((f) => {
      const count = posts.filter(p => f.match(p.id)).length;
      return (
        <a href={`#${f.id}`} class="folder-card" data-category={f.id} style={`--card-bg: ${f.color}; --card-border: ${f.borderColor}; --tab-bg: ${f.tabColor}; --active-border: ${f.activeColor};`}>
          <div class="folder-tab" style={`background: var(--tab-bg); border-color: ${f.borderColor};`}>
            <span class="folder-tab-text">{f.tab}</span>
          </div>
          <div class="folder-body" style={`background: ${f.color}; border-color: ${f.borderColor};`}>
            <div class="folder-icon" set:html={icons[f.icon]}></div>
            <h2 class="folder-title">{f.title}</h2>
            <p class="folder-desc">{f.desc}</p>
            <span class="folder-count">{count} 篇</span>
            <span class="folder-vol">{f.vol}</span>
          </div>
        </a>
      );
    })}
  </div>

  <div class="index-recent" id="recent-section">
    <h3 class="recent-heading" id="recent-heading">最近更新</h3>
    <div class="recent-list" id="recent-list">
      {sortedPosts.map((post) => {
        const cat = folders.find(f => f.match(post.id))?.id ?? 'note';
        return (
          <a href={`/posts/${post.id}/`} class="recent-item" data-category={cat}>
            <time class="recent-date">
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <span class="recent-title">{post.data.title}</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  const items = document.querySelectorAll('.recent-item');
  const heading = document.getElementById('recent-heading');
  const folders = document.querySelectorAll('.folder-card');
  const names = { interview: '杂志采访烤肉', archive: '博文考古整理', radio: '电台内容存档', note: '博主的碎碎念' };

  function filter(cat) {
    let count = 0;
    items.forEach(el => {
      if (!cat || el.dataset.category === cat) {
        el.style.display = 'flex';
        count++;
      } else {
        el.style.display = 'none';
      }
    });
    folders.forEach(f => f.classList.toggle('active', f.dataset.category === cat));
    if (cat && names[cat]) {
      heading.textContent = `${names[cat]} · 共 ${count} 篇`;
    } else {
      heading.textContent = '最近更新';
    }
  }

  function getHash() {
    return window.location.hash.replace('#', '');
  }

  // On page load
  const initial = getHash();
  if (initial && names[initial]) filter(initial);

  // On hash change
  window.addEventListener('hashchange', () => {
    const cat = getHash();
    if (cat && names[cat]) {
      filter(cat);
      document.getElementById('recent-section')?.scrollIntoView({ behavior: 'smooth' });
    } else {
      filter('');
    }
  });

  // Click handler on folder cards to prevent default anchor scroll
  folders.forEach(f => {
    f.addEventListener('click', (e) => {
      const cat = f.dataset.category;
      if (cat && names[cat]) {
        e.preventDefault();
        window.location.hash = cat;
      }
    });
  });
</script>

<style>
  .index-header {
    text-align: center;
    padding: 48px 20px 32px;
  }

  .index-title {
    font-family: 'Noto Serif SC', 'Noto Serif JP', Georgia, serif;
    font-size: 24px;
    font-weight: 400;
    color: #444;
    letter-spacing: 0.4em;
    margin: 0 0 10px 0;
  }

  .index-subtitle {
    font-size: 12px;
    color: #a8a29e;
    letter-spacing: 0.15em;
    margin: 0;
  }

  .folder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 36px;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px 60px;
  }

  .project-shelf {
    max-width: 900px;
    margin: 0 auto 50px;
    padding: 0 20px;
  }

  .project-shelf-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 30px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eee8e2;
  }

  .project-shelf-heading h2 {
    margin: 0;
    color: #77716b;
    font-family: 'Noto Serif SC', 'Noto Serif JP', Georgia, serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
  }

  .project-shelf-heading span {
    color: #c2b8ae;
    font-family: 'SF Mono', Consolas, monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
  }

  .project-folder {
    position: relative;
    display: block;
    color: #393631;
    text-decoration: none;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .project-folder:hover {
    transform: translateY(-5px);
  }

  .project-folder:focus-visible {
    outline: 2px solid #9c615b;
    outline-offset: 5px;
  }

  .project-folder-tab {
    position: absolute;
    top: -24px;
    left: 0;
    z-index: 1;
    height: 24px;
    padding: 0 18px;
    border: 1px solid #ead8d2;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
    background: #ead8d2;
    color: #76504c;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 24px;
  }

  .project-folder-body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 22px 40px;
    min-height: 170px;
    padding: 30px;
    overflow: hidden;
    border: 1px solid #ead8d2;
    border-radius: 0 16px 16px 16px;
    background:
      linear-gradient(90deg, transparent 0 74%, rgba(156, 67, 60, 0.04) 74%),
      #fdf7f4;
  }

  .project-folder-mark {
    position: absolute;
    right: -18px;
    bottom: -42px;
    width: 140px;
    height: 140px;
    border: 1px solid rgba(156, 67, 60, 0.15);
    border-radius: 50%;
    color: rgba(156, 67, 60, 0.08);
    font-family: Georgia, serif;
    font-size: 64px;
    line-height: 128px;
    text-align: center;
  }

  .project-folder-main {
    min-width: 0;
  }

  .project-folder-kicker {
    color: #9c615b;
    font-family: 'SF Mono', Consolas, monospace;
    font-size: 9px;
    letter-spacing: 0.13em;
  }

  .project-folder h3 {
    margin: 9px 0 9px;
    color: #4c4540;
    font-family: 'Noto Serif SC', 'Noto Serif JP', Georgia, serif;
    font-size: 21px;
    font-weight: 400;
    line-height: 1.4;
  }

  .project-folder p {
    max-width: 610px;
    margin: 0;
    color: #918780;
    font-size: 12px;
    line-height: 1.8;
  }

  .project-folder-meta {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto auto;
    align-content: start;
    gap: 2px 8px;
    padding-right: 26px;
    font-family: 'SF Mono', Consolas, monospace;
  }

  .project-folder-meta strong {
    color: #9c615b;
    font-size: 13px;
    font-weight: 500;
    text-align: right;
  }

  .project-folder-meta span {
    color: #b6aaa1;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .project-folder-enter {
    grid-column: 1 / -1;
    color: #9c615b;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .folder-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: #333;
    margin-top: 24px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .folder-card:hover {
    transform: translateY(-6px);
  }

  .folder-card.active {
    transform: translateY(-6px);
  }

  .folder-card.active .folder-body {
    box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--active-border, #c7c2bc) 75%, transparent);
  }

  .folder-tab {
    position: absolute;
    top: -24px;
    left: 0;
    height: 24px;
    padding: 0 18px;
    border-radius: 10px 10px 0 0;
    border: 1px solid;
    border-bottom: none;
    display: flex;
    align-items: center;
    z-index: 1;
  }

  .folder-tab-text {
    font-size: 11px;
    font-weight: 600;
    color: #5c5c5c;
    letter-spacing: 0.1em;
  }

  .folder-body {
    position: relative;
    border: 1px solid;
    border-radius: 0 16px 16px 16px;
    padding: 28px;
    min-height: 170px;
    display: flex;
    flex-direction: column;
  }

  .folder-icon {
    margin-bottom: 14px;
    color: #a8a29e;
  }

  .folder-icon :global(svg) {
    display: block;
  }

  .folder-title {
    font-family: 'Noto Serif SC', 'Noto Serif JP', Georgia, serif;
    font-size: 16px;
    font-weight: 600;
    color: #444;
    margin: 0 0 8px 0;
    line-height: 1.5;
  }

  .folder-desc {
    font-size: 13px;
    color: #a8a29e;
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }

  .folder-count {
    display: inline-block;
    margin-top: 16px;
    font-size: 12px;
    color: #bcb7b0;
    font-family: 'SF Mono', Consolas, monospace;
  }

  .folder-vol {
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-size: 10px;
    color: #d4cfc8;
    letter-spacing: 0.15em;
    font-family: 'SF Mono', Consolas, monospace;
  }

  .index-recent {
    max-width: 600px;
    margin: 0 auto 80px;
    padding: 0 20px;
  }

  .recent-heading {
    font-family: 'Noto Serif SC', Georgia, serif;
    font-size: 13px;
    font-weight: 400;
    color: #a8a29e;
    letter-spacing: 0.2em;
    margin: 0 0 12px 0;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0edeb;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
  }

  .recent-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    text-decoration: none;
    border-bottom: 1px solid #fafaf8;
    transition: opacity 0.2s;
  }

  .recent-item:hover {
    opacity: 0.7;
  }

  .recent-date {
    font-size: 11px;
    color: #c7c2bc;
    white-space: nowrap;
    font-family: 'SF Mono', Consolas, monospace;
    flex-shrink: 0;
  }

  .recent-title {
    font-size: 13px;
    color: #666;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .project-shelf {
      margin-bottom: 46px;
    }
    .project-folder-body {
      display: block;
      min-height: 0;
      padding: 24px 22px;
      background: #fdf7f4;
    }
    .project-folder h3 {
      font-size: 18px;
    }
    .project-folder-meta {
      grid-template-columns: repeat(3, auto 1fr);
      gap: 2px 6px;
      margin-top: 18px;
      padding: 12px 0;
      border-top: 1px solid #eee1dc;
      border-bottom: 1px solid #eee1dc;
    }
    .project-folder-meta strong {
      text-align: left;
    }
    .project-folder-enter {
      display: block;
      margin-top: 14px;
    }
    .folder-grid {
      gap: 28px;
    }
    .index-title {
      font-size: 20px;
    }
  }
</style>
