---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ProjectArchiveShell from '../../components/project/ProjectArchiveShell.astro';
import { hydrateProjectPeople } from '../../lib/projectPeople';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const projectReference = (entry: any) => entry.data.project?.id === project.id;
const [tracks, acts, events, threads, personContexts, identities, sources] = await Promise.all([
  getCollection('projectTracks', projectReference),
  getCollection('projectActs', projectReference),
  getCollection('projectEvents', projectReference),
  getCollection('projectThreads', projectReference),
  getCollection('projectPeople', projectReference),
  getCollection('people'),
  getCollection('projectSources', projectReference),
]);
const people = hydrateProjectPeople(personContexts, identities);
---

<ProjectLayout title={project.data.title} description={project.data.summary} visualTheme={project.data.visualTheme}>
  <ProjectArchiveShell
    project={project}
    tracks={tracks}
    acts={acts}
    events={events}
    threads={threads}
    people={people}
    sources={sources}
  />
</ProjectLayout>
